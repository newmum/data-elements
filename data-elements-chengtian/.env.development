# 应用端口
VITE_APP_PORT=3000
# 代理前缀
VITE_APP_BASE_API=/dev-api
VITE_APP_NIFI_API=/nifi/api

# 接口地址
VITE_APP_API_URL=http://localhost:8088

# 能力中心本地开发地址；生产环境使用各工程对应的同源部署子路径。
VITE_QIZHI_BASE_URL=http://localhost:3001/
VITE_REPORT_APP_URL=http://localhost:3004/
VITE_HAITONG_BASE_URL=http://localhost:3002/
VITE_WANXIANG_GOVERNANCE_URL=http://localhost:3010/
VITE_SEARCH_APP_URL=http://localhost:3300/

# WebSocket 端点（不配置则关闭），本地示例：ws://localhost:8989/ws
# VITE_APP_WS_ENDPOINT=

# 启用 Mock 服务
# VITE_MOCK_DEV_SERVER=false
