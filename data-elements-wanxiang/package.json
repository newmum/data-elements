    "react-router-dom": "7.8.2",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "js-yaml": "5.4.2",
    "sm-crypto": "0.5.7",
    "typescript": "5.9.3",
