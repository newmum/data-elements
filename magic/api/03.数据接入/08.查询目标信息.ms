// 接口：08.查询目标信息
// 路由：POST /ods/queryTargetTableInfo
// 业务说明：目录目标表 ID 从 ES 目录投影读取；表和字段详情以 db_table_t、；使用请求参数 tid。
/*
 * 查询资源目录已配置的目标表
 *
 * 目录目标表 ID 从 ES 目录投影读取；表和字段详情以 db_table_t、
 * db_table_column_t 为准，确保迁移后的物理主表是唯一事实来源。
 */
import com.linewell.dataelement.elasticsearch.EsCommonService as esCommonService

// 解析请求体并为可选参数设置默认值。
var catalogId = body?.tid
if (catalogId == null || catalogId == '') {
    // 参数或业务状态不满足要求时立即终止请求。
    exit 400, 'tid参数错误'
}
// 执行 Elasticsearch 查询或索引同步，保持检索结果与主数据一致。
var catalog = esCommonService.getDocument('dataassets', catalogId + '')
var tableId = catalog?.targetTableId
if (tableId == null || tableId == '') {
    // 返回当前业务分支的标准结果。
    return {propList: {}, tableItems: []}
}
// 从 MySQL 业务表读取当前有效数据。
var table = db.table('db_table_t').where().eq('tid', tableId).eq('is_del', 0).selectOne()
if (table == null) {
    // 参数或业务状态不满足要求时立即终止请求。
    exit 404, '目标表不存在'
}
// 从 MySQL 业务表读取当前有效数据。
var datasource = db.table('db_datasource_t').where()
    .eq('tid', table.datasourceId).eq('is_del', 0).selectOne()
// 返回当前业务分支的标准结果。
return {
    propList: {
        dbId: table.datasourceId,
        dbType: datasource?.dbType,
        tableNameCn: table.tableNameCn,
        tableName: table.tableName
    },
    // 从 MySQL 业务表读取当前有效数据。
    tableItems: db.table('db_table_column_t').where()
        .eq('table_id', tableId).eq('is_del', 0)
        .orderBy('ordinal_position', 'asc').select()
}
