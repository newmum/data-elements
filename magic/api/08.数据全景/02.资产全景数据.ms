// 接口：02.资产全景数据
// 路由：GET /scene/index
// 业务说明：调用数源、归集、共享、整合及近期统计接口，合并为资产全景大屏所需的数据结构。
import "@get:/scene/data-count/innerStat" as cityDepartHj
import "@get:/scene/data-count/outerStat" as areaHj
import "@get:/scene/data-count/converge" as assetClassHjCount
import "@get:/scene/data-count/stats" as topStats
import "@get:/scene/data-count/recent" as recent
import "@get:/scene/data-count/data-share" as dataShare
import "@get:/scene/data-count/data-dst" as dataDst
import "@get:/scene/data-count/data-zh" as dataZh

var topCount = topStats();

// 返回当前业务分支的标准结果。
return {
  "collectTotle": topCount.dataTotal,
  "collectToday": topCount.dataTodayTotal,
  "shareTotle": topCount.dataConverge,
  "shareToday": topCount.dataShare,
  ...recent(),//  近期增长情况
  ...dataShare(),// 第一层
  ...dataZh(),// 第二层
  ...dataDst(),// 第三层
  
  "city_depart_hj": cityDepartHj(),
  "area_hj": areaHj(),
  "asset_class_hj_count": assetClassHjCount(),
}


// 生成增值数据
var getAdd=()=>{
  var now = new Date();
  // 当前小时整点时间戳
  var hourTime = new Date(
    now.getYear(),
    now.getMonth(),
    now.getDate(),
    now.getHours(),
    0,
    0
  ).getTime();
  var nowTime = now.getTime();
  // 当前小时已过秒数，每到整点自动重置
  var seconds = Math.floor((nowTime - hourTime) / 1000);
  // 返回当前业务分支的标准结果。
  return seconds;
}
const addCount = getAdd()
// 返回当前业务分支的标准结果。
return {
        "collectTotle": 203162926+addCount,
        "collectToday": 43971+addCount,
        "shareTotle": 105680+addCount,
        "shareToday": 6133+addCount,

        // ====================== 第一层 =====================
        "shareLayerLeft": [
