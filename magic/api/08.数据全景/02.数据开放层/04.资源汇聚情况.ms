          \"catalogName\": \"标准表_执法案件信息表\",\n                \"organName\": \"\",\n                \"rowTotal\": 0\n            },\n            {\n                \"tableName\": \"标准库_地波雷达观测信息\",\n                \"datasourceName\": \"\",\n                \"catalogName\": \"标准库_地波雷达观测信息(DWD_DISAS_PRE_GROUND_OBSERVE_INFO)\",\n                \"organName\": \"\",\n                \"rowTotal\": 0\n            },\n            {\n                \"tableName\": \"\",\n                \"datasourceName\": \"\",\n                \"catalogName\": \"FBYZT_SJ_BHJQ(FBYZT_SJ_BHJQ)\",\n                \"organName\": \"\",\n                \"rowTotal\": 0\n            },\n            {\n                \"tableName\": \"标准库_浮标海洋环境浮标次表层流数据_观测网\",\n                \"datasourceName\": \"海上福建数据专区标准库\",\n                \"catalogName\": \"标准库_浮标海洋环境浮标次目录层流数据_观测网(DWD_DISAS_PRE_GC_BUOY_SURFACE_CURR_DTL)\",\n                \"organName\": \"福建省渔业减灾中心\",\n                \"rowTotal\": 0\n            }\n        ],\n        \"table2\": [\n            {\n                \"apiName\": \"养殖证大屏接口-养殖类型占比\",\n                \"catalogName\": \"\",\n                \"organName\": \"\",\n                \"totalApiRequest\": 9\n            },\n            {\n                \"apiName\": \"渔船区域数量统计接口\",\n                \"catalogName\": \"\",\n                \"organName\": \"\",\n                \"totalApiRequest\": 84\n            },\n            {\n                \"apiName\": \"养殖证大屏接口-养殖区/限养区/禁养区卡片\",\n                \"catalogName\": \"\",\n                \"organName\": \"\",\n                \"totalApiRequest\": 8\n            },\n            {\n                \"apiName\": \"十五个海洋经济数据-柱形图\",\n                \"catalogName\": \"\",\n                \"organName\": \"\",\n                \"totalApiRequest\": 8\n            },\n            {\n                \"apiName\": \"渔船聚合接口1\",\n                \"catalogName\": \"\",\n                \"organName\": \"\",\n                \"totalApiRequest\": 69\n            },\n            {\n                \"apiName\": \"养殖证大屏接口-养殖现状年月\",\n                \"catalogName\": \"\",\n                \"organName\": \"\",\n                \"totalApiRequest\": 6\n            },\n            {\n                \"apiName\": \"大华视频-获取设备视频通道\",\n                \"catalogName\": \"\",\n                \"organName\": \"\",\n                \"totalApiRequest\": 5\n            },\n            {\n                \"apiName\": \"动管-海洋空间、省外船舶、预警信息数量统计\",\n                \"catalogName\": \"\",\n                \"organName\": \"\",\n                \"totalApiRequest\": 46\n            },\n            {\n                \"apiName\": \"深远海设备\",\n                \"catalogName\": \"\",\n                \"organName\": \"\",\n                \"totalApiRequest\": 3\n            },\n            {\n                \"apiName\": \"动管-省外渔船定位数据\",\n                \"catalogName\": \"\",\n                \"organName\": \"\",\n                \"totalApiRequest\": 3\n            }\n        ],\n        \"table3\": []\n    }\n}",
