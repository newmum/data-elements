// 接口：04.资源汇聚情况
// 路由：GET /scene/share/data-collect
// 业务说明：说明: 统计资源汇聚情况，包括饼图占比、表格数据；涉及 rm_org_t 等业务表。
// 资源汇聚情况接口
// 路径: /api/dataassets/resourceConverge
// 方法: POST
// 参数: 无
// 说明: 统计资源汇聚情况，包括饼图占比、表格数据

import tenantEs;
import '@/common/configData' as configData;

try {
    // keyword字段求和脚本
    var sumScript = "if (doc['FIELD'].size() == 0) { return 0; } try { return Double.parseDouble(doc['FIELD'].value); } catch(Exception e) { return 0; }";

    // ========== 1. 饼图统计：各资源类型数量 ==========
    // count1: catalog有targetTableId的数量（有汇聚数据的目录）
    var pieDsl = {
        "size": 0,
        "aggs": {
            "catalog_with_target": {
                "filter": {
                    "bool": {
                        "filter": [
                            { "term": { "assetType": "catalog" } },
                            { "term": { "assetStatus": 2 } },
                            { "exists": { "field": "targetTableId" } }
                        ]
                    }
                }
            },
            "api_with_catalog": {
                "filter": {
                    "bool": {
                        "filter": [
                            { "term": { "assetType": "api" } }
                        ],
                        "must_not": [
                            { "term": { "catalogId": "" } }
                        ]
                    }
                }
            },
            "file_with_catalog": {
                "filter": {
                    "bool": {
                        "filter": [
                            { "term": { "assetType": "file" } }
                        ],
                        "must_not": [
                            { "term": { "catalogId": "" } }
                        ]
                    }
                }
            }
        }
    };

    // 执行 Elasticsearch 查询或索引同步，保持检索结果与主数据一致。
    var pieResult = tenantEs.index(configData().es_dataassets).search(pieDsl);
    var pie = {
        count1: pieResult.aggregations.catalog_with_target.doc_count,
        count2: pieResult.aggregations.api_with_catalog.doc_count,
        count3: pieResult.aggregations.file_with_catalog.doc_count
    };

    // ========== 2. 表格1：汇聚表列表（catalog有targetTableId的才是汇聚表） ==========
    // 先查所有有targetTableId的catalog，获取汇聚表ID列表
    var convergeCatalogDsl = {
        "size": 100,
        "query": {
            "bool": {
                "filter": [
                    { "term": { "assetType": "catalog" } },
                    { "exists": { "field": "targetTableId" } }
                ]
            }
        },
        "_source": ["targetTableId", "catalogName", "orgId"]
    };
    // 执行 Elasticsearch 查询或索引同步，保持检索结果与主数据一致。
    var convergeCatalogResult = tenantEs.index(configData().es_dataassets).search(convergeCatalogDsl);

    // catalogName映射：targetTableId -> catalogName
    var catalogNameMap = {};
    var convergedtableIdList = [];
    var convergeOrgIdSet = {};
    for (hit in convergeCatalogResult.hits.hits) {
        var src = hit._source;
        if (src.targetTableId) {
            convergedtableIdList.push(src.targetTableId);
            catalogNameMap[src.targetTableId] = src.catalogName || '';
        }
        if (src.orgId) { convergeOrgIdSet[src.orgId] = true; }
    }

    // 查询汇聚表详情，按rowCount降序取前10
    var table1Dsl = {
        "size": 10,
        "query": {
            "bool": {
                "filter": [
                    { "term": { "assetType": "table" } },
                    { "terms": { "id": convergedtableIdList } }
                ]
            }
        },
        "sort": [{ "rowCount": { "order": "desc", "unmapped_type": "keyword" } }],
        "_source": ["id", "tableNameCn", "dbId", "rowCount", "orgId"]
    };
    // 执行 Elasticsearch 查询或索引同步，保持检索结果与主数据一致。
    var table1Result = tenantEs.index(configData().es_dataassets).search(table1Dsl);

    // 收集所有dbId和orgId，用于批量查询
    var dbIdSet = {};
    var orgIdSet = {};
    for (orgId in convergeOrgIdSet.keySet()) { orgIdSet[orgId] = true; }
    for (hit in table1Result.hits.hits) {
        var src = hit._source;
        if (src.dbId) { dbIdSet[src.dbId] = true; }
        if (src.orgId) { orgIdSet[src.orgId] = true; }
    }

    // 批量查询db信息（获取dbName）
    var dbMap = {};
    for (dbId in dbIdSet.keySet()) {
        var dbDsl = {
            "size": 1,
            "query": { "term": { "id": dbId } },
            "_source": ["dbName"]
        };
        // 执行 Elasticsearch 查询或索引同步，保持检索结果与主数据一致。
        var dbResult = tenantEs.index(configData().es_dataassets).search(dbDsl);
        if (dbResult.hits.hits.size() > 0) {
            dbMap[dbId] = dbResult.hits.hits[0]._source.dbName || '';
        }
    }

    // 批量查询组织名称（ogName）
    var orgNameMap = {};
    var orgIdList = [];
    for (orgId in orgIdSet.keySet()) {
        orgIdList.push(orgId);
    }
    if (orgIdList.size() > 0) {
        // 从 MySQL 业务表读取当前有效数据。
        var orgList = db.table("rm_org_t")
            .where().in("id", orgIdList)
            .select();
        for (org in orgList) {
            orgNameMap[org.id] = org.name;
        }
    }

    // 组装table1数据
    var table1 = [];
    for (hit in table1Result.hits.hits) {
        var src = hit._source;
        var rowTotal = 0;
        if (src.rowCount) {
            try { rowTotal = Double.parseDouble(src.rowCount); } catch(e) { rowTotal = 0; }
        }
        table1.push({
            tableName: src.tableNameCn || '',
            datasourceName: dbMap[src.dbId] || '',
            catalogName: catalogNameMap[src.id] || '',
            organName: orgNameMap[src.orgId] || '',
            rowTotal: rowTotal
        });
    }

    // ========== 3. 表格2：api资产列表 ==========
    var table2Dsl = {
        "size": 10,
        "query": {
            "bool": {
                "filter": [
                    { "term": { "assetType": "api" } }
                ],
                "must_not": [
                    { "term": { "catalogId": "" } }
                ]
            }
        },
        "sort": [{ "requestCount": { "order": "desc", "unmapped_type": "keyword" } }],
        "_source": ["name", "catalogId", "orgId", "requestCount"]
    };
    // 执行 Elasticsearch 查询或索引同步，保持检索结果与主数据一致。
    var table2Result = tenantEs.index(configData().es_dataassets).search(table2Dsl);

    // 收集catalogId用于查询catalogName
    var apiCatalogIdSet = {};
    var apiOrgIdSet = {};
    for (hit in table2Result.hits.hits) {
        var src = hit._source;
        if (src.catalogId) { apiCatalogIdSet[src.catalogId] = true; }
        if (src.orgId) { apiOrgIdSet[src.orgId] = true; }
    }

    // 查询catalog信息
    var apiCatalogMap = {};
    for (catalogId in apiCatalogIdSet.keySet()) {
        var catDsl = {
            "size": 1,
            "query": { "term": { "id": catalogId } },
            "_source": ["catalogName"]
        };
        // 执行 Elasticsearch 查询或索引同步，保持检索结果与主数据一致。
        var catResult = tenantEs.index(configData().es_dataassets).search(catDsl);
        if (catResult.hits.hits.size() > 0) {
            apiCatalogMap[catalogId] = catResult.hits.hits[0]._source.catalogName || '';
        }
    }

    // 补充table2中未查询的orgId
    for (orgId in apiOrgIdSet.keySet()) {
        if (!orgNameMap[orgId]) {
            orgIdList.push(orgId);
        }
    }
    if (orgIdList.size() > 0) {
        // 从 MySQL 业务表读取当前有效数据。
        var orgList2 = db.table("rm_org_t")
            .where().in("id", orgIdList)
            .select();
        for (org in orgList2) {
            orgNameMap[org.id] = org.name;
        }
    }

    // 组装table2数据
    var table2 = [];
    for (hit in table2Result.hits.hits) {
        var src = hit._source;
        var totalApiRequest = 0;
        if (src.requestCount) {
            try { totalApiRequest = Double.parseDouble(src.requestCount); } catch(e) { totalApiRequest = 0; }
        }
        table2.push({
            apiName: src.name || '',
            catalogName: apiCatalogMap[src.catalogId] || '',
            organName: orgNameMap[src.orgId] || '',
            totalApiRequest: totalApiRequest
        });
    }

    // ========== 4. 表格3：file资产列表 ==========
    var table3Dsl = {
        "size": 10,
        "query": {
            "bool": {
                "filter": [
                    { "term": { "assetType": "file" } }
                ],
                "must_not": [
                    { "term": { "catalogId": "" } }
                ]
            }
        },
        "sort": [{ "downloadCount": { "order": "desc", "unmapped_type": "keyword" } }],
        "_source": ["fileName", "catalogId", "orgId", "downloadCount"]
    };
    // 执行 Elasticsearch 查询或索引同步，保持检索结果与主数据一致。
    var table3Result = tenantEs.index(configData().es_dataassets).search(table3Dsl);

    // 收集file的catalogId
    var fileCatalogIdSet = {};
    var fileOrgIdSet = {};
    for (hit in table3Result.hits.hits) {
        var src = hit._source;
        if (src.catalogId) { fileCatalogIdSet[src.catalogId] = true; }
        if (src.orgId) { fileOrgIdSet[src.orgId] = true; }
    }

    // 查询catalog信息
    var fileCatalogMap = {};
    for (catalogId in fileCatalogIdSet.keySet()) {
        if (!apiCatalogMap[catalogId]) {
            var catDsl2 = {
                "size": 1,
                "query": { "term": { "id": catalogId } },
                "_source": ["catalogName"]
            };
            // 执行 Elasticsearch 查询或索引同步，保持检索结果与主数据一致。
            var catResult2 = tenantEs.index(configData().es_dataassets).search(catDsl2);
            if (catResult2.hits.hits.size() > 0) {
                fileCatalogMap[catalogId] = catResult2.hits.hits[0]._source.catalogName || '';
            }
        } else {
            fileCatalogMap[catalogId] = apiCatalogMap[catalogId];
        }
    }

    // 补充table3中未查询的orgId
    for (orgId in fileOrgIdSet.keySet()) {
        if (!orgNameMap[orgId]) {
            orgIdList.push(orgId);
        }
    }
    if (orgIdList.size() > 0) {
        // 从 MySQL 业务表读取当前有效数据。
        var orgList3 = db.table("rm_org_t")
            .where().in("id", orgIdList)
            .select();
        for (org in orgList3) {
            orgNameMap[org.id] = org.name;
        }
    }

    // 组装table3数据
    var table3 = [];
    for (hit in table3Result.hits.hits) {
        var src = hit._source;
        var downloadTotal = 0;
        if (src.downloadCount) {
            try { downloadTotal = Double.parseDouble(src.downloadCount); } catch(e) { downloadTotal = 0; }
        }
        table3.push({
            fileName: src.fileName || '',
            catalogName: fileCatalogMap[src.catalogId] || apiCatalogMap[src.catalogId] || '',
            organName: orgNameMap[src.orgId] || '',
            downloadTotal: downloadTotal
        });
    }

    // ========== 返回结果 ==========
    return {
        pie: pie,
        table1: table1,
        table2: table2,
        table3: table3
    };

} catch(e) {
    // 参数或业务状态不满足要求时立即终止请求。
    exit 500, '查询资源汇聚情况失败: ' + e.message;
}
