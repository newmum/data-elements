// 业务说明：调用共享、归集和应用成效接口，合并共享开放层大屏的展示数据。
import "@get:/scene/share/data-share" as dataShare;
import "@get:/scene/share/data-collect" as dataCollect;
import "@get:/scene/share/data-application" as dataApplication;

