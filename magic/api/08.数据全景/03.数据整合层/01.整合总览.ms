// 接口：01.整合总览
// 路由：GET /scene/zh/overview
// 业务说明：说明: 统计基础层(DWD)、整合层(DWM)、服务层(DWS)三层数据仓库的资源总览。
// 数据分层资源总览接口
// 路径: /api/dataassets/warehouseOverview
// 方法: POST
// 说明: 统计基础层(DWD)、整合层(DWM)、服务层(DWS)三层数据仓库的资源总览

import tenantEs;
import '@/common/configData' as configData;
import "@post:/sym/getDict" as getDict;
import cn.hutool.core.util.StrUtil;
import java.text.DecimalFormat;

try {
    // ========== 1. 获取字典数据 ==========
    body = { dictCode: "dataSourceType", showRow: true };
    var dictItems = getDict();

    // 构建 tid -> 字典项 映射
    var tidToItem = {};
    for (item in dictItems) {
        tidToItem[item.tid] = item;
    }

    // 三层配置及其 tid
    var layers = [
        { code: "dwd", name: "基础层", alias: "DWD" },
        { code: "dwm", name: "整合层", alias: "DWM" },
        { code: "dws", name: "服务层", alias: "DWS" }
    ];

    // 找到每层的 tid（level-3）
    var layerTids = {};
    for (layer in layers) {
        for (item in dictItems) {
            if (item.dictCode == layer.code && item.levelNo == 3) {
                layerTids[layer.code] = item.tid;
                break;
            }
        }
    }

    // ========== 2. 提取分库（level-4，parentId 指向层的 tid）==========
    // 结构: [{ layerCode, dbDictCode, dbName, dbTid }]
    var dbList = [];
    for (item in dictItems) {
        if (item.levelNo == 4) {
            for (layer in layers) {
                if (item.parentId == layerTids[layer.code]) {
                    dbList.push({
                        layerCode: layer.code,
                        dbDictCode: item.dictCode,
                        dbName: item.dictName,
                        dbTid: item.tid
                    });
                    break;
                }
            }
        }
    }

    // ========== 3. 构建 dsType -> 分库归属映射 ==========
    // 遍历所有 level-4+ 的字典项，通过 treePath 找到所属分层和分库
    // treePath: "0.根tid.分层tid.分库tid.分域tid..."
    var dsTypeMapping = {};
    for (item in dictItems) {
        // 跳过 level-3（分层本身）
        if (item.levelNo <= 3) { continue; }
        if (StrUtil.isBlank(item.treePath)) { continue; }

        var parts = StrUtil.split(item.treePath, '.');
        if (parts.get(3) == null) { continue; }

        // parts.get(0) = "0"
        // parts.get(1) = 根tid
        // parts.get(2) = 分层tid
        // parts.get(3) = 分库tid
        var layerTid = parts.get(2);
        var dbTid = parts.get(3);

        // 找到所属分层
        var foundLayer = null;
        for (layer in layers) {
            if (layerTids[layer.code] == layerTid) {
                foundLayer = layer;
                break;
            }
        }
        if (!foundLayer) { continue; }

        // 找到分库
        var foundDb = null;
        for (db in dbList) {
            if (db.dbTid == dbTid && db.layerCode == foundLayer.code) {
                foundDb = db;
                break;
            }
        }
        if (foundDb) {
            dsTypeMapping[item.dictCode] = {
                layerCode: foundLayer.code,
                dbDictCode: foundDb.dbDictCode
            };
        }
    }

    // ========== 4. 查询 catalog 聚合统计 ==========
    var catalogAggDsl = {
        "size": 0,
        "query": { "term": { "assetType": "catalog" } },
        "aggs": {
            "by_ds_type": {
                "terms": { "field": "dataSourceType", "size": 1000 }
            }
        }
    };
    // 执行 Elasticsearch 查询或索引同步，保持检索结果与主数据一致。
    var catalogAggResult = tenantEs.index(configData().es_dataassets).search(catalogAggDsl);

    // 初始化每个分库的 catalog 计数
    var catalogCounts = [];
    for (db in dbList) {
        catalogCounts.push({
            layerCode: db.layerCode,
            dbDictCode: db.dbDictCode,
            count: 0
        });
    }

    // 遍历聚合结果填充计数
    var aggBuckets = catalogAggResult.aggregations.by_ds_type.buckets;
    for (bucket in aggBuckets) {
        var dsType = bucket.key;
        var count = bucket.doc_count;
        var mapping = dsTypeMapping[dsType];
        if (mapping) {
            for (idx, cc in catalogCounts) {
                if (cc.layerCode == mapping.layerCode && cc.dbDictCode == mapping.dbDictCode) {
                    catalogCounts[idx].count = cc.count + count;
                    break;
                }
            }
        }
    }

    // ========== 5. 查询有 targetTableId 的 catalog ==========
    // 先做一次小查询，确认 catalog 文档有哪些字段
    var probeDsl = {
        "size": 3,
        "query": {
            "bool": {
                "filter": [
                    { "term": { "assetType": "catalog" } },
                    { "exists": { "field": "targetTableId" } }
                ]
            }
        }
    };
    // 执行 Elasticsearch 查询或索引同步，保持检索结果与主数据一致。
    var probeResult = tenantEs.index(configData().es_dataassets).search(probeDsl);
    var probeHits = probeResult.hits.total.value;

    // 同时查一下 catalog 的全部字段（不加 exists 过滤）
    var probeDsl2 = {
        "size": 3,
        "query": { "term": { "assetType": "catalog" } }
    };
    // 执行 Elasticsearch 查询或索引同步，保持检索结果与主数据一致。
    var probeResult2 = tenantEs.index(configData().es_dataassets).search(probeDsl2);
    // probeResult2 用于调试 catalog 字段信息

    // 正式查询有 targetTableId 的 catalog
    var catalogWithTargetDsl = {
        "size": 1000,
        "query": {
            "bool": {
                "filter": [
                    { "term": { "assetType": "catalog" } },
                    { "exists": { "field": "targetTableId" } }
                ]
            }
        },
        "_source": ["dataSourceType", "targetTableId", "catalogName"]
    };
    // 执行 Elasticsearch 查询或索引同步，保持检索结果与主数据一致。
    var catalogTargetResult = tenantEs.index(configData().es_dataassets).search(catalogWithTargetDsl);

    // 为每个分库收集 tableId
    var dbTableIds = [];
    for (db in dbList) {
        dbTableIds.push({
            layerCode: db.layerCode,
            dbDictCode: db.dbDictCode,
            tableIds: [],
            tableNames: {}
        });
    }

    // 遍历 catalog 填充 tableId
    for (hit in catalogTargetResult.hits.hits) {
        var src = hit._source;
        var dsType = src.dataSourceType;
        var targetTableId = src.targetTableId;
        if (!dsType || !targetTableId) { continue; }

        var mapping = dsTypeMapping[dsType];
        if (mapping) {
            for (item in dbTableIds) {
                if (item.layerCode == mapping.layerCode && item.dbDictCode == mapping.dbDictCode) {
                    item.tableIds.push(targetTableId);
                    if (src.catalogName) {
                        item.tableNames[targetTableId] = src.catalogName;
                    }
                    break;
                }
            }
        }
    }

    // ========== 6. 批量查询 table 的 recordCount ==========
    var allTableIds = [];
    for (item in dbTableIds) {
        for (tid in item.tableIds) {
            allTableIds.push(tid);
        }
    }

    var recordCountMap = {};
    if (allTableIds.length > 0) {
        var tableDsl = {
            "size": 1000,
            "query": {
                "bool": {
                    "filter": [
                        { "term": { "assetType": "table" } },
                        { "terms": { "_id": allTableIds } }
                    ]
                }
            },
            "_source": ["id", "recordCount"]
        };
        // 执行 Elasticsearch 查询或索引同步，保持检索结果与主数据一致。
        var tableResult = tenantEs.index(configData().es_dataassets).search(tableDsl);
        for (hit in tableResult.hits.hits) {
            var src = hit._source;
            var rc = 0;
            if (src.recordCount) {
                try { rc = Double.parseDouble(src.recordCount); } catch(e) { rc = 0; }
            }
            recordCountMap[hit._id] = rc;
        }
    }

    // ========== 7. 格式化函数 ==========
    var df = new DecimalFormat("0.#");
    var formatVolume = (count) => {
        if (count >= 10000) {
            // 返回当前业务分支的标准结果。
            return df.format(count * 1.0 / 10000) + "万条";
        }
        // 返回当前业务分支的标准结果。
        return count + "条";
    };

    // ========== 8. 组装返回结果 ==========
    var result = [];
    for (layer in layers) {
        var layerCode = layer.code;
        var databaseList = [];
        var tableTotalCount = 0;
        var totalVolume = 0;
        var dbCount = 0;

        for (dbItem in dbList) {
            if (dbItem.layerCode != layerCode) { continue; }
            dbCount = dbCount + 1;

            var dbDictCode = dbItem.dbDictCode;
            var dbName = dbItem.dbName;

            // 找 catalogCount
            var catalogCount = 0;
            for (cc in catalogCounts) {
                if (cc.layerCode == layerCode && cc.dbDictCode == dbDictCode) {
                    catalogCount = cc.count;
                    break;
                }
            }

            // 找 tableIds 和 tableNames
            var tableIds = [];
            var tableNames = {};
            for (dti in dbTableIds) {
                if (dti.layerCode == layerCode && dti.dbDictCode == dbDictCode) {
                    tableIds = dti.tableIds;
                    tableNames = dti.tableNames;
                    break;
                }
            }

            // 构建 tableList
            var tableList = [];
            var volume = 0;
            for (tableId in tableIds) {
                var rc = recordCountMap[tableId] ? recordCountMap[tableId] : 0;
                volume = volume + rc;
                var tName = tableNames[tableId] ? tableNames[tableId] : tableId;
                tableList.push({
                    tableName: tName,
                    dataVolume: formatVolume(rc)
                });
            }

            databaseList.push({
                databaseName: dbName,
                tableCount: tableList.size(),
                dataVolume: formatVolume(volume),
                tableList: tableList
            });
            tableTotalCount = tableTotalCount + catalogCount;
            totalVolume = totalVolume + volume;
        }

        result.push({
            warehouseName: layer.name + " " + layer.alias,
            warehouseCount: dbCount,
            tableTotalCount: tableTotalCount,
            dataVolume: formatVolume(totalVolume),
            databaseList: databaseList
        });
    }

    // ===== 调试信息 =====
    var catalogWithTargetTotal = catalogTargetResult.hits.total.value;
    var catalogSample = {};
    for (probeHit in probeResult2.hits.hits) {
        catalogSample = probeHit._source;
        break;
    }

    // 返回当前业务分支的标准结果。
    return result;

} catch(e) {
    // 参数或业务状态不满足要求时立即终止请求。
    exit 500, '查询数据分层资源总览失败: ' + e.message;
}
