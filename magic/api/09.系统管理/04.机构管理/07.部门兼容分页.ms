// 接口：07.部门兼容分页
// 路由：GET /sym/org/pageOrg
// 业务说明：按现有组织权限范围查询本地机构，返回旧部门页面需要的分页字段结构。
import org.ssssssss.script.parsing.ast.statement.Return
import cn.dev33.satoken.stp.StpUtil;
import cn.hutool.core.util.NumberUtil;
import "@post:/sym/user/me" as me;
import log;
import '@/common/configData' as configData

var isPage = false
if (limit){
    offset = (offset || 0).asInt();
    limit = (limit || 10).asInt();
    isPage = true
}

// 从 MySQL 业务表读取当前有效数据。
var parent = db.table("rm_org_t").where()
                          .eq("id", me().orgRootId)
                          .eq("deleted", 0) 
                          .selectOne();
// 构建查询条件
var result = db.table("rm_org_t").where().eq("deleted", 0)

if (parent){
    result = result.like('serial_number', parent.serialNumber + '%');
}

var idList = []
// 根据ID列表查询
if (ids && ids != "") {
    var idList = ids.split(",");
    result = result.in("id", idList);
}

// 组织名称模糊查询
if (name && name != "") {
    result = result.like("name", "%" + name + "%");
}

// 查询总数
var total = result.count();

if (isPage){
    // 分页查询
    return result.orderBy("sort_num").page(limit, offset)
} else {
    // 返回当前业务分支的标准结果。
    var list = result.orderBy("sort_num").select();
    list.addFirst({
        id:"ROOT",
        name:"全部机构"
    })
    return {list: list};
}
