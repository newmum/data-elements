// 接口：06.部门兼容分页(复制)
// 路由：GET /sym/org/pageOrg_copy
// 业务说明：兼容旧部门分页调用，按当前组织权限范围读取本地机构并返回历史字段结构。
import org.ssssssss.script.parsing.ast.statement.Return
import cn.dev33.satoken.stp.StpUtil;
import cn.hutool.core.util.NumberUtil;
import "@post:/sym/user/me" as me;
import log;
import '@/common/configData' as configData

var isPage = false
if (limit){
    offset = (offset || 0).asInt();
    limit = (limit || 10).asInt();
    isPage = true
}

// 从 MySQL 业务表读取当前有效数据。
// var parent = db.table("rm_org_t").where()
//                           .eq("id", me().orgRootId)
//                           .eq("deleted", 0)
//                           .selectOne();
var orgRootId = "2026503859392086017"
// 过滤掉其他组织几个
var filterId = ["2026218882519662594","2021069041682481153","2021059952730570753","1796489999114715137"]

var sql = """
    SELECT * 
    FROM rm_org_t t
    <where>
        deleted = 0
        AND CHAR_LENGTH(serial_number) <= 4
    </where>
"""
var list = db.select(sql)
serialNumbers = list?.forEach( item -> item.serialNumber)

var sql1 = """
    SELECT * 
    FROM rm_org_t t
    <where>
        deleted = 0
       <if test="serialNumbers != null and serialNumbers.size()>0">
        AND (
        <foreach collection="serialNumbers" item="sn" separator=" OR ">
            serial_number LIKE concat(#{sn},'%')
        </foreach>
        )
        </if>
        <if test="ids != null and ids != ''">
            AND id IN
            <foreach collection="idArr" item="iid" open="(" separator="," close=")">
                #{iid,jdbcType=BIGINT}
            </foreach>
        </if>
        <if test="name != null and name != ''">
            AND name LIKE concat('%',#{name},'%')
        </if>
    </where>
    ORDER BY sort_num
"""


var parent = db.table("rm_org_t").where()
                          //.eq("id", orgRootId)
                          .notIn("id",filterId)
                          .lte("CHAR_LENGTH(serial_number)",4)
                          .eq("deleted", 0)
                          .select();
return parent
serialNumbers = parent?.forEach( item -> item.serialNumber)

 
// 构建查询条件
var result = db.table("rm_org_t").where().eq("deleted", 0)

if (parent){
    result = result.like('serial_number', parent.serialNumber + '%');
}

var idList = []
// 根据ID列表查询
if (ids && ids != "") {
    var idList = ids.split(",");
    result = result.in("id", idList);
}

// 组织名称模糊查询
if (name && name != "") {
    result = result.like("name", "%" + name + "%");
}

// 查询总数
var total = result.count();

if (isPage){
    // 分页查询
    return result.orderBy("sort_num").page(limit, offset)
} else {
    // 返回当前业务分支的标准结果。
    return {list: result.orderBy("sort_num").select()};
}
