// 接口：08.应用系统选择项
// 路由：POST /dst/application/options
// 业务说明：应用系统轻量选择项（POST /dst/application/options）。复用数据源管理菜单的数据范围：ALL 返回全部应用系统，ORG 返回本部门范围，OWNER 仅返回本人登记项；前端参数不参与范围判定；涉及 pingao_application_sync_state_t、sym_application_t 等业务表。
// Data-source registration application options use the same configurable
// ALL / ORG / OWNER scope as the data-source management list.
// Scope comes only from the authenticated session; client parameters cannot
// expand an application's visible range.
import tenantRuntime
import dataScope

var tenantId = tenantRuntime.id()
var escapedTenantId = (tenantId + '').replace("'", "''")
var scopeResource = 'MENU:2081000000000000002'
var state = db.select("""
    select has_success as hasSuccess
      from pingao_application_sync_state_t
     where tenant_id = '${escapedTenantId}'
""")
var hasSuccessfulSnapshot = state != null && state.size() > 0 && state[0].hasSuccess == 1
if (hasSuccessfulSnapshot) {
    var applications = db.select("""
        select app_name as label, tid as value, org_id as orgId, created_by as createdBy
          from sym_application_t
         where tenant_id = '${escapedTenantId}'
           and data_origin = 'PINGAO'
           and sync_active = 1
           and ifnull(is_del, 0) = 0
         order by app_name asc, tid asc
    """)
    return dataScope.visibleDataSourcesFor(scopeResource, applications)
}
var applications = db.select("""
    select concat(app_name, '（历史）') as label, tid as value, org_id as orgId, created_by as createdBy
      from sym_application_t
     where tenant_id = '${escapedTenantId}'
       and data_origin = 'LEGACY'
       and ifnull(is_del, 0) = 0
     order by app_name asc, tid asc
""")
return dataScope.visibleDataSourcesFor(scopeResource, applications)
