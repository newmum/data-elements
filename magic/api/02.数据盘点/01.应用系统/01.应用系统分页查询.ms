// 接口：01.应用系统分页查询
// 路由：POST /dst/application/page
// 业务说明：按当前租户和页面筛选条件从应用系统检索索引读取分页数据，补充组织等展示字段后返回列表与总数。
import tenantEs
import tenantRuntime
import '@/common/configData' as configData
import java.util.List

// 高频列表只读 dataassets 索引。MySQL 主表仍是事实来源，索引由保存接口和盘点维护接口同步。
var text = (value) => value == null ? '' : value + ''
var blank = (value) => text(value).trim() == ''
var addCondition = (must, mustNot, item) => {
    if (item == null || blank(item.field) || item.field == 'assetType') {
        return
    }
    var type = item.type == null ? 'match' : item.type
    var value = item.value
    if (type == 'null') {
        mustNot.add({ exists: { field: item.field } })
    } else if (!blank(value) && type == 'like') {
        must.add({ wildcard: { [item.field]: `*${value}*` } })
    } else if (!blank(value) && type == 'in') {
        must.add({ terms: { [item.field]: value instanceof List ? value : [value] } })
    } else if (!blank(value)) {
        must.add({ term: { [item.field]: value } })
    }
}
// 解析请求体并为可选参数设置默认值。
var pageNum = body?.pageNum == null ? 1 : body.pageNum::int
var pageSize = body?.pageSize == null ? 20 : body.pageSize::int
var tenantId = tenantRuntime.id()
var must = [ { term: { assetType: 'app' } } ]
var mustNot = [
    { wildcard: { appName: '未匹配业务系统*' } },
    { wildcard: { applicationSystemName: '未匹配业务系统*' } }
]
for (condition in (body?.conditions == null ? [] : body.conditions)) {
    addCondition(must, mustNot, condition)
}
var sortField = blank(body?.sortField) ? 'updatedTime' : body.sortField
var sortDir = text(body?.sortDir).toLowerCase() == 'asc' ? 'asc' : 'desc'
var sort = {}
sort[sortField] = { order: sortDir, unmapped_type: 'keyword' }
// 执行 Elasticsearch 查询或索引同步，保持检索结果与主数据一致。
var result = tenantEs.index(configData().es_dataassets).search({
    from: (pageNum - 1) * pageSize,
    size: pageSize,
    track_total_hits: true,
    query: { bool: { must: must, must_not: mustNot } },
    sort: [sort]
})
var list = []
for (hit in (result?.hits?.hits == null ? [] : result.hits.hits)) {
    if (hit?._source != null) {
        list.add(hit._source)
    }
}
// orgId 是应用主数据的唯一组织关联键；当前页组织一次性批量回填，绝不以 manageUnit 替代 orgId。
var orgIds = []
var seenOrgIds = {}
for (item in list) {
    var orgId = text(item?.orgId).trim()
    if (!blank(orgId) && seenOrgIds[orgId] == null) {
        orgIds.add(orgId)
        seenOrgIds[orgId] = true
    }
}
var orgNameById = {}
if (orgIds.size() > 0) {
    var orgRows = db.table('rm_org_t').where()
        .in('id', orgIds)
        .eq('tenantId', tenantId)
        .eq('deleted', '0')
        .select()
    for (org in (orgRows == null ? [] : orgRows)) {
        orgNameById[text(org.id)] = text(org.name)
    }
}
for (item in list) {
    var orgId = text(item?.orgId).trim()
    item.orgName = orgNameById[orgId] == null ? '' : orgNameById[orgId]
}
var totalObject = result?.hits?.total
var total = totalObject?.value == null ? (totalObject == null ? 0 : totalObject) : totalObject.value
// 返回当前业务分支的标准结果。
return { pageNum: pageNum, pageSize: pageSize, total: total, list: list }
