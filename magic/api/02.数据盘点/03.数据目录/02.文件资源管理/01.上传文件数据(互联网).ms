// 接口：01.上传文件数据(互联网)
// 路由：POST /dst/catalog/files/upload
// 业务说明：1. 获取上传数据：分全量上传、部分上传；使用请求参数 data。
// ============== 互联网数据 --> 公安网数据 ==============
// 1. 获取上传数据：分全量上传、部分上传
// 2. 调用公安网插入数据接口
// 3. 收尾：依据情况执行是否删除已上传数据
// ========================================================
import log;
import http;
import cn.hutool.core.codec.Base64;

import request;
import "@post:/dst/catalog/detail" as queryById;
import "@get:/dst/catalog/files/curd-data" as curdData;


// token
var token =  token || request.getHeaders("token")[0]


// 公安网地址
var url = "http://192.168.175.86:8088/"

// 解析请求体并为可选参数设置默认值。
const {tid,op,data} = body;
//全量情况下先初始化、然后批量获取数据（服用查询预览接口）
if(op=="all"){
    // 上传全部数据，则需获取表所有数据
    body.data = [];
    var { resName, tableId, dbId } = queryById();

    // 表中全部数据
    var action = "get"
    var pageNo = 1
    var pageSize = 9999999
    var {rows} = curdData();

    // 上传数据
     body = {
        tid,
        data: rows
    }
    async http.connect(`${url}dataassets/manage/fileCatalog/upload-ga`)
           .contentType("application/json")
            .header({token})
           .body(body)   
           .post()
           .getBody();
    // 返回当前业务分支的标准结果。
    return "全量上报提交成功，请耐心等待";
}
// -------------------------------生产逻辑-------------------------------------
// 1. 调外部 POST
// result = http.connect("http://192.168.39.5:30800/server/forward")
//            .contentType("application/json")
//            .header("X-Node-Address", "http://44.1.1.218:81/api/govern/saveToTableGa")
//            .body(body)      // 直接传 Map，框架自动序列化 JSON
//            .post()
//            .getBody()
// --------------------------------本次调试-------------------------------------
// 2. 调本地 POST
log.debug("params->{}",body);
var result = http.connect(`${url}dataassets/manage/fileCatalog/upload-ga`)
           .contentType("application/json")
            .header({token})
           .body(body)   
           .post()
           .getBody();
// 返回当前业务分支的标准结果。
return result.data;
