{"properties": {}, "id": "f5b058d07924559e94f899a97b48bc9e", "script": "import systemJobs;\n\nsystemJobs.run(\"data-quality-schedule\");\n", "groupId": "30fc31e9c7e057f4983f7342850f1811", "name": "03.数据质量计划", "createTime": 1790900480658, "updateTime": 1790900480658, "lock": null, "createBy": null, "updateBy": null, "path": "data-quality-schedule", "cron": "*/30 * * * * ?", "enabled": true, "description": "扫描已启用且到期的质检任务并生成执行记录。单个质检任务的周期由其自身的 Cron 表达式决定。"}