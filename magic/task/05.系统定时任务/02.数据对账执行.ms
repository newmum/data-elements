{"properties": {}, "id": "ed0593273fc75b2c8f90e207b77bcab8", "script": "import systemJobs;\n\nsystemJobs.run(\"reconciliation-worker\");\n", "groupId": "30fc31e9c7e057f4983f7342850f1811", "name": "02.数据对账执行", "createTime": 1790900480658, "updateTime": 1790900480658, "lock": null, "createBy": null, "updateBy": null, "path": "reconciliation-worker", "cron": "*/2 * * * * ?", "enabled": true, "description": "领取待处理的对账运行及分桶。所有任务共享一个执行器，不会为每条任务或每张表创建定时任务。"}