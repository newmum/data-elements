<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.linewell.dataelement</groupId>
    <artifactId>haitong-kafka-legacy-extension</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>haitong-kafka-legacy-nar</artifactId>
  <packaging>nar</packaging>
  <dependencies>
    <dependency>
      <groupId>com.linewell.dataelement</groupId>
      <artifactId>haitong-kafka-legacy-service</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.apache.nifi</groupId>
          <artifactId>nifi-kafka-service-shared</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.nifi</groupId>
      <artifactId>nifi-kafka-shared</artifactId>
      <version>${nifi.version}</version>
    </dependency>
    <dependency>
      <groupId>at.yawk.lz4</groupId>
      <artifactId>lz4-java</artifactId>
      <version>1.10.4</version>
    </dependency>
    <dependency>
      <groupId>org.apache.nifi</groupId>
      <artifactId>nifi-kafka-service-api-nar</artifactId>
      <version>${nifi.version}</version>
      <type>nar</type>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.nifi</groupId>
        <artifactId>nifi-nar-maven-plugin</artifactId>
        <version>2.1.0</version>
        <extensions>true</extensions>
      </plugin>
    </plugins>
  </build>
</project>
