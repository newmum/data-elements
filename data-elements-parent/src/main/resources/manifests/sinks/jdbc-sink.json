{
  "key": "sink.jdbc",
  "category": "sink",
  "label": "JDBC \u5199\u5165",
  "icon": "database",
  "description": "\u901a\u7528 JDBC \u76ee\u6807\u6570\u636e\u5e93\u5199\u5165\u7ec4\u4ef6",
  "fields": [
    { "key": "dbType", "label": "\u6570\u636e\u5e93\u7c7b\u578b", "type": "select", "required": true, "default": "MySQL", "options": [
      { "label": "MySQL / Doris / StarRocks", "value": "MySQL" },
      { "label": "MariaDB", "value": "MARIADB" },
      { "label": "PostgreSQL / TDSQL-PG", "value": "PostgreSQL" },
      { "label": "\u9ad8\u65af GaussDB / openGauss", "value": "GAUSSDB" },
      { "label": "Oracle", "value": "Oracle" },
      { "label": "Oracle 12+", "value": "Oracle 12+" },
      { "label": "SQL Server", "value": "SQLSERVER" },
      { "label": "IBM Db2", "value": "DB2" },
      { "label": "\u8fbe\u68a6 DM", "value": "DM" },
      { "label": "\u4eba\u5927\u91d1\u4ed3 KingbaseES", "value": "KINGBASE" },
      { "label": "GBase 8a", "value": "GBASE8A" },
      { "label": "GBase 8s", "value": "GBASE8S" },
      { "label": "\u795e\u901a Oscar", "value": "OSCAR" },
      { "label": "\u701a\u9ad8 HighGo", "value": "HIGHGO" },
      { "label": "OceanBase", "value": "OCEANBASE" },
      { "label": "ClickHouse", "value": "CLICKHOUSE" },
      { "label": "Elasticsearch", "value": "ELASTICSEARCH" }
    ] },
    { "key": "jdbcUrl", "label": "JDBC URL", "type": "text", "required": true, "placeholder": "jdbc:postgresql://host:5432/database?currentSchema=public&sslmode=disable" },
    { "key": "username", "label": "\u7528\u6237\u540d", "type": "text", "required": true },
    { "key": "password", "label": "\u5bc6\u7801", "type": "password", "required": true },
    { "key": "table", "label": "\u76ee\u6807\u8868", "type": "text", "required": true },
    { "key": "writerType", "label": "\u76ee\u6807\u8868\u5199\u5165\u7ec4\u4ef6", "type": "select", "required": true, "options": [
      { "label": "Linewell \u81ea\u5b9a\u4e49\u5199\u5165\uff08\u652f\u6301 MERGE\uff09", "value": "LINEWELL_PUT_DATABASE_RECORD" },
      { "label": "NiFi \u539f\u751f PutDatabaseRecord", "value": "NIFI_PUT_DATABASE_RECORD" }
    ], "help": "Oracle \u548c OceanBase Oracle \u9ed8\u8ba4\u4f7f\u7528 Linewell \u81ea\u5b9a\u4e49\u5199\u5165\uff0c\u5176\u4ed6\u6570\u636e\u5e93\u9ed8\u8ba4\u4f7f\u7528 NiFi \u539f\u751f PutDatabaseRecord\u3002\u9009\u62e9 Linewell \u7ec4\u4ef6\u65f6\uff0c\u5199\u5165\u65b9\u5f0f\u4f1a\u81ea\u52a8\u9ed8\u8ba4\u4e3a MERGE\uff0c\u4e5f\u53ef\u4ee5\u6839\u636e\u4e1a\u52a1\u6539\u9009 UPSERT\u3001INSERT\u3001UPDATE \u6216 DELETE\u3002\u9009\u62e9 NiFi \u539f\u751f\u7ec4\u4ef6\u65f6\u4f1a\u81ea\u52a8\u5207\u56de\u65b0\u589e\uff08INSERT\uff09\uff0c\u4e14 MERGE \u4e0d\u53ef\u9009\u3002" },
    { "key": "statementType", "label": "\u5199\u5165\u65b9\u5f0f", "type": "select", "default": "INSERT", "options": [
      { "label": "\u6709\u5219\u66f4\u65b0\u65e0\u5219\u65b0\u589e\uff08UPSERT\uff09", "value": "UPSERT" },
      { "label": "\u5408\u5e76\u5199\u5165\uff08MERGE\uff0cLinewell \u81ea\u5b9a\u4e49\u7ec4\u4ef6\uff09", "value": "MERGE" },
      { "label": "\u65b0\u589e\uff08INSERT\uff09", "value": "INSERT" },
      { "label": "\u66f4\u65b0\uff08UPDATE\uff09", "value": "UPDATE" },
      { "label": "\u5220\u9664\uff08DELETE\uff09", "value": "DELETE" }
    ] },
    { "key": "updateKeys", "label": "\u66f4\u65b0\u952e", "type": "text", "default": "", "placeholder": "id", "help": "UPSERT\u3001UPDATE \u6216 DELETE \u65f6\u7528\u4e8e\u5339\u914d\u76ee\u6807\u8868\u8bb0\u5f55" }
  ],
  "compile": {
    "controllerServices": [{ "localId": "dbcp", "type": "org.apache.nifi.dbcp.DBCPConnectionPool", "properties": {
      "Database Connection URL": "${config.jdbcUrl}",
      "Database Driver Class Name": "${jdbc.driverClass}",
      "Database Driver Locations": "${jdbc.driverLocations}",
      "Database User": "${config.username}",
      "Password": "${config.password}"
    }}],
    "processors": [
      { "localId": "merge", "type": "org.apache.nifi.processors.standard.MergeRecord", "properties": {
        "Record Reader": "${cs.jsonReader}",
        "Record Writer": "${cs.jsonWriter}",
        "Merge Strategy": "Bin-Packing Algorithm",
        "Correlation Attribute Name": "filename",
        "Attribute Strategy": "Keep Only Common Attributes",
        "Minimum Number of Records": "1",
        "Maximum Number of Records": "10000",
        "Minimum Bin Size": "0 B",
        "Maximum Number of Bins": "10"
      }},
      { "localId": "put", "type": "org.apache.nifi.processors.standard.PutDatabaseRecord", "properties": {
      "Record Reader": "${cs.jsonReader}",
      "Database Connection Pooling Service": "${cs.dbcp}",
      "Database Type": "${jdbc.databaseType}",
      "Statement Type": "${jdbc.statementType}",
      "Update Keys": "${config.updateKeys}",
      "Table Name": "${config.table}",
      "Unmatched Field Behavior": "Ignore Unmatched Fields",
      "Unmatched Column Behavior": "Ignore Unmatched Columns"
    }}],
    "internalConnections": [
      { "from": "merge", "to": "put", "relationship": "merged" }
    ],
    "inlet": "merge",
    "outlets": []
  }
}
