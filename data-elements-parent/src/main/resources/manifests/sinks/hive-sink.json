{
  "key": "sink.hive",
  "category": "sink",
  "label": "华为 MRS Hive 写入",
  "icon": "database",
  "description": "向华为 MRS Hive 目标表写入数据。默认链路先合并 JSON 记录，再转换为 CSV、设置唯一文件名，最后由 Linewell PutHwHDFS 写入目标表的 HDFS 目录；也可选择原生 PutHDFS 或 HiveRecordPut。HDFS 模式要求目标表的文件格式与 CSV 输出一致。连接和认证配置由服务器管理，写入语义仅支持 INSERT。",
  "fields": [
    { "key": "dbType", "label": "数据库类型", "type": "select", "default": "HIVE", "required": true, "options": [{ "label": "华为 MRS Hive", "value": "HIVE" }], "group": "connection" },
    { "key": "hiveProfile", "label": "MRS 配置集", "type": "select", "default": "default", "required": true, "options": [{ "label": "默认华为 MRS Hive 配置集", "value": "default" }], "group": "connection", "help": "选择服务端管理的连接与认证配置；配置集名称与 Hive 数据库名分别设置。" },
    { "key": "database", "label": "Hive 数据库", "type": "text", "default": "default", "required": true, "group": "connection", "help": "目标表所在的 Hive 数据库；即使与认证用户名相同，也按数据库名使用。" },
    { "key": "table", "label": "目标表", "type": "text", "required": true, "group": "write" },
    { "key": "hiveWriteMode", "label": "目标表写入组件", "type": "select", "default": "LINEWELL_HDFS", "required": true, "options": [{ "label": "Linewell PutHwHDFS（默认）", "value": "LINEWELL_HDFS" }, { "label": "NiFi 原生 PutHDFS", "value": "HDFS_BATCH" }, { "label": "标准写入（HiveRecordPut）", "value": "HIVE_RECORD_PUT" }], "group": "write", "help": "HDFS 写入会按 JSON 记录合并、CSV 转换、唯一文件名和文件落地生成 NiFi 链路。部署时会核验当前节点已安装所选写入组件。" },
    { "key": "hdfsDirectory", "label": "HDFS 写入目录", "type": "text", "group": "write", "help": "仅 PutHwHDFS 或 PutHDFS 使用。不填时按 Hive 默认仓库目录推导；目标表使用自定义 LOCATION 时，请填写该表实际目录，并确认表的文件格式及分隔符与 CSV 输出一致。同名文件按 replace 处理，不会清空或覆盖整张 Hive 表。" },
    { "key": "statementType", "label": "写入语义", "type": "select", "default": "INSERT", "required": true, "options": [{ "label": "新增写入（INSERT）", "value": "INSERT" }], "group": "write", "help": "Hive 目标不支持通用 JDBC 的 UPSERT、UPDATE、DELETE。" }
  ],
  "compile": {
    "controllerServices": [
      { "localId": "kerberos", "type": "org.apache.nifi.kerberos.KerberosKeytabUserService", "properties": {
        "Kerberos Principal": "${config.userPrincipal}",
        "Kerberos Keytab": "${config.keytabPath}"
      }},
      { "localId": "dbcp", "type": "org.apache.nifi.dbcp.DBCPConnectionPool", "properties": {
      "Database Connection URL": "${config.jdbcUrl}",
      "Database Driver Class Name": "${jdbc.driverClass}",
      "Database Driver Locations": "${jdbc.driverLocations}",
      "Kerberos User Service": "${cs.kerberos}",
      "Database User": "${config.username}",
      "Password": "${config.password}"
    }}
    ],
    "processors": [{ "localId": "put", "type": "com.linewell.nifi.hive.HiveRecordPut", "properties": {
      "Record Reader": "${cs.jsonReader}",
      "Database Connection Pooling Service": "${cs.dbcp}",
      "Hive Database": "${config.database}",
      "Target Table": "${config.table}",
      "Maximum Rows Per Statement": "500"
    }}],
    "inlet": "put",
    "outlets": []
  }
}
