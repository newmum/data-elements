{
  "key": "source.gbase8s",
  "category": "source",
  "label": "GBase 8s 数据源",
  "icon": "gbase",
  "description": "南大通用 GBase 8s OLTP 数据源",
  "fields": [
    { "key": "host", "label": "主机", "type": "text", "required": true },
    { "key": "port", "label": "端口", "type": "number", "default": 9088 },
    { "key": "database", "label": "数据库", "type": "text", "required": true },
    { "key": "serverName", "label": "实例名", "type": "text", "required": true },
    { "key": "dbLocale", "label": "DB Locale", "type": "text", "default": "zh_CN.utf8", "group": "advanced" },
    { "key": "clientLocale", "label": "Client Locale", "type": "text", "default": "zh_CN.utf8", "group": "advanced" },
    { "key": "username", "label": "用户名", "type": "text", "required": true },
    { "key": "password", "label": "密码", "type": "password", "required": true },
    { "key": "table", "label": "表名", "type": "table-picker", "required": true },
    { "key": "incrementalColumn", "label": "增量字段", "type": "text" },
    { "key": "schedulingPeriod", "label": "调度周期", "type": "duration", "default": "60 sec", "group": "schedule" }
  ],
  "compile": {
    "controllerServices": [{ "localId": "dbcp", "type": "org.apache.nifi.dbcp.DBCPConnectionPool", "properties": {
      "Database Connection URL": "jdbc:gbasedbt-sqli://${config.host}:${config.port}/${config.database}:GBASEDBTSERVER=${config.serverName};DB_LOCALE=${config.dbLocale};CLIENT_LOCALE=${config.clientLocale}",
      "Database Driver Class Name": "com.gbasedbt.jdbc.IfxDriver",
      "Database Driver Locations": "${jdbc.driverLocations}/gbasedbtjdbc.jar",
      "Database User": "${config.username}",
      "Password": "${config.password}"
    }}],
    "processors": [
      { "localId": "fetch", "type": "org.apache.nifi.processors.standard.GenerateTableFetch", "schedulingPeriod": "${config.schedulingPeriod}", "schedulingStrategy": "TIMER_DRIVEN", "properties": { "Database Connection Pooling Service": "${cs.dbcp}", "Table Name": "${config.table}", "Maximum-value Columns": "${config.incrementalColumn}", "Partition Size": "10000" } },
      { "localId": "execute", "type": "org.apache.nifi.processors.standard.ExecuteSQLRecord", "properties": { "Database Connection Pooling Service": "${cs.dbcp}", "Record Writer": "${cs.jsonWriter}" } }
    ],
    "internalConnections": [{ "from": "fetch", "to": "execute", "relationship": "success" }],
    "outlets": [{ "name": "default", "processorRef": "execute", "relationship": "success" }]
  }
}
