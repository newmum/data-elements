{
  "key": "source.dameng",
  "category": "source",
  "label": "达梦 DM 数据源",
  "icon": "dameng",
  "description": "从达梦数据库抽取数据,支持全量/增量",
  "fields": [
    { "key": "host", "label": "主机", "type": "text", "required": true },
    { "key": "port", "label": "端口", "type": "number", "default": 5236 },
    { "key": "database", "label": "数据库/服务名", "type": "text", "required": true },
    { "key": "defaultSchema", "label": "默认 Schema", "type": "text" },
    { "key": "compatibleMode", "label": "兼容模式", "type": "select", "default": "ORACLE", "options": [
      { "label": "Oracle", "value": "ORACLE" },
      { "label": "MySQL", "value": "MYSQL" },
      { "label": "DM", "value": "DM" },
      { "label": "SQL Server", "value": "SQL_SERVER" }
    ] },
    { "key": "username", "label": "用户名", "type": "text", "required": true },
    { "key": "password", "label": "密码", "type": "password", "required": true },
    { "key": "table", "label": "表名", "type": "table-picker", "required": true },
    { "key": "incrementalColumn", "label": "增量字段", "type": "text", "help": "使用数据源登记时选择的时间戳字段，同时用于水位与按月分片；全量模式保留该字段用于分片" },
    { "key": "schedulingPeriod", "label": "调度周期", "type": "duration", "default": "60 sec", "group": "schedule" }
  ],
  "compile": {
    "controllerServices": [
      {
        "localId": "dbcp",
        "type": "org.apache.nifi.dbcp.DBCPConnectionPool",
        "properties": {
          "Database Connection URL": "jdbc:dm://${config.host}:${config.port}/${config.database}?schema=${config.defaultSchema}&compatibleMode=${config.compatibleMode}",
          "Database Driver Class Name": "dm.jdbc.driver.DmDriver",
          "Database Driver Locations": "${jdbc.driverLocations}/DmJdbcDriver18-8.1.3.140.jar",
          "Database User": "${config.username}",
          "Password": "${config.password}"
        }
      }
    ],
    "processors": [
      {
        "localId": "fetch",
        "type": "com.linewell.microservice.processors.database.GenerateDateTableFetch",
        "schedulingPeriod": "${config.schedulingPeriod}",
        "schedulingStrategy": "TIMER_DRIVEN",
        "properties": {
          "Database Connection Pooling Service": "${cs.dbcp}",
          "Table Name": "${config.table}",
          "Maximum-value Columns": "${config.incrementalColumn}",
          "gen-table-fetch-partition-size": "10000",
          "gen-table-column-for-val-partitioning": "${config.incrementalColumn}",
          "fetch-partition-type": "2",
          "fetch-partition-type-count": "1",
          "Max Wait Time": "0 seconds"
        }
      },
      {
        "localId": "execute",
        "type": "org.apache.nifi.processors.standard.ExecuteSQLRecord",
        "properties": {
          "Database Connection Pooling Service": "${cs.dbcp}",
          "Record Writer": "${cs.jsonWriter}"
        }
      }
    ],
    "internalConnections": [
      { "from": "fetch", "to": "execute", "relationship": "success" }
    ],
    "outlets": [
      { "name": "default", "processorRef": "execute", "relationship": "success" }
    ]
  }
}
