{
  "key": "source.kafka",
  "category": "source",
  "label": "Kafka 数据源",
  "icon": "kafka",
  "description": "从 Apache Kafka/Confluent 兼容集群消费消息",
  "fields": [
    { "key": "bootstrapServers", "label": "Bootstrap Servers", "type": "text", "required": true, "placeholder": "h1:9092,h2:9092" },
    { "key": "topic", "label": "Topic", "type": "text", "required": true },
    { "key": "groupId", "label": "Consumer Group", "type": "text", "default": "haitong-nifi" },
    { "key": "messageFormat", "label": "消息格式", "type": "select", "default": "JSON", "options": [{ "label": "结构化 JSON", "value": "JSON" }] },
    { "key": "schemaRequired", "label": "要求结构化消息", "type": "boolean", "default": true },
    { "key": "maxPollRecords", "label": "单次拉取条数", "type": "number", "default": 500 },
    { "key": "securityProtocol", "label": "安全协议", "type": "select", "default": "PLAINTEXT", "options": [
      { "label": "PLAINTEXT", "value": "PLAINTEXT" },
      { "label": "SSL", "value": "SSL" },
      { "label": "SASL_PLAINTEXT", "value": "SASL_PLAINTEXT" },
      { "label": "SASL_SSL", "value": "SASL_SSL" }
    ] },
    { "key": "saslMechanism", "label": "SASL 机制", "type": "select", "default": "PLAIN", "options": [
      { "label": "PLAIN", "value": "PLAIN" },
      { "label": "SCRAM-SHA-256", "value": "SCRAM-SHA-256" },
      { "label": "SCRAM-SHA-512", "value": "SCRAM-SHA-512" },
      { "label": "GSSAPI", "value": "GSSAPI" }
    ], "group": "security" },
    { "key": "credentialRef", "label": "Kafka 凭据引用", "type": "text", "group": "security", "placeholder": "credential://kafka/structured-surveillance" },
    { "key": "principal", "label": "Kerberos Principal", "type": "text", "group": "security" },
    { "key": "keytabPath", "label": "Keytab 路径", "type": "text", "group": "security" },
    { "key": "krb5ConfPath", "label": "krb5.conf 路径", "type": "text", "group": "security" },
    { "key": "kerberosServiceName", "label": "Kerberos 服务名", "type": "text", "default": "kafka", "group": "security" },
    { "key": "schemaRegistryUrl", "label": "Schema Registry", "type": "text", "group": "advanced" },
    { "key": "schedulingPeriod", "label": "调度周期", "type": "duration", "default": "0 sec", "group": "schedule" }
  ],
  "compile": {
    "controllerServices": [{ "localId": "kafka", "type": "org.apache.nifi.kafka.service.Kafka3ConnectionService", "properties": {
      "bootstrap.servers": "${config.bootstrapServers}",
      "security.protocol": "${config.securityProtocol}",
      "sasl.mechanism": "${config.saslMechanism}",
      "credentials.reference": "${config.credentialRef}",
      "sasl.kerberos.service.name": "${config.kerberosServiceName}",
      "kerberos.principal": "${config.principal}",
      "kerberos.keytab": "${config.keytabPath}",
      "request.timeout.ms": "30000",
      "client.id": "haitong-nifi"
    }}],
    "processors": [{ "localId": "consume", "type": "org.apache.nifi.processors.kafka.pubsub.ConsumeKafka", "schedulingPeriod": "${config.schedulingPeriod}", "schedulingStrategy": "TIMER_DRIVEN", "properties": { "Kafka Connection Service": "${cs.kafka}", "Topic Name(s)": "${config.topic}", "Group ID": "${config.groupId}", "Offset Reset": "earliest" } }],
    "outlets": [{ "name": "default", "processorRef": "consume", "relationship": "success" }]
  }
}
