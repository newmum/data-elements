{
  "key": "source.vertica",
  "category": "source",
  "label": "Vertica 数据源",
  "icon": "database",
  "description": "Vertica JDBC 数据源，支持字段探查、分页预览及时间分片抽取。",
  "fields": [
    {
      "key": "host",
      "label": "主机",
      "type": "text",
      "required": true
    },
    {
      "key": "port",
      "label": "端口",
      "type": "number",
      "required": true,
      "default": 5433
    },
    {
      "key": "database",
      "label": "数据库",
      "type": "text",
      "required": true
    },
    {
      "key": "currentSchema",
      "label": "Schema",
      "type": "text",
      "default": "public"
    },
    {
      "key": "username",
      "label": "用户名",
      "type": "text",
      "required": true
    },
    {
      "key": "password",
      "label": "密码",
      "type": "password",
      "required": true
    },
    {
      "key": "table",
      "label": "表名",
      "type": "table-picker",
      "required": true
    },
    {
      "key": "incrementalColumn",
      "label": "增量字段",
      "type": "text",
      "help": "留空则全量抽取"
    },
    {
      "key": "schedulingPeriod",
      "label": "调度周期",
      "type": "duration",
      "default": "60 sec",
      "group": "schedule"
    }
  ],
  "compile": {
    "controllerServices": [
      {
        "localId": "dbcp",
        "type": "org.apache.nifi.dbcp.DBCPConnectionPool",
        "properties": {
          "Database Connection URL": "${jdbc.url}",
          "Database Driver Class Name": "${jdbc.driverClass}",
          "Database Driver Locations": "${jdbc.driverLocations}",
          "Database User": "${config.username}",
          "Password": "${config.password}"
        }
      }
    ],
    "processors": [
      {
        "localId": "fetch",
        "type": "com.linewell.microservice.processors.database.GenerateDateTableFetch",
        "schedulingPeriod": "${config.schedulingPeriod}",
        "schedulingStrategy": "TIMER_DRIVEN",
        "properties": {
          "Database Connection Pooling Service": "${cs.dbcp}",
          "Table Name": "${config.table}",
          "Maximum-value Columns": "${config.incrementalColumn}",
          "gen-table-fetch-partition-size": "10000",
          "gen-table-column-for-val-partitioning": "${config.incrementalColumn}",
          "fetch-partition-type": "2",
          "fetch-partition-type-count": "1",
          "Max Wait Time": "0 seconds"
        }
      },
      {
        "localId": "execute",
        "type": "org.apache.nifi.processors.standard.ExecuteSQLRecord",
        "properties": {
          "Database Connection Pooling Service": "${cs.dbcp}",
          "Record Writer": "${cs.jsonWriter}"
        }
      }
    ],
    "internalConnections": [
      {
        "from": "fetch",
        "to": "execute",
        "relationship": "success"
      }
    ],
    "outlets": [
      {
        "name": "default",
        "processorRef": "execute",
        "relationship": "success"
      }
    ]
  }
}
