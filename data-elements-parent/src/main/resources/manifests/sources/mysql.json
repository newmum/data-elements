{
  "key": "source.mysql",
  "category": "source",
  "label": "MySQL 数据源",
  "icon": "mysql",
  "description": "从 MySQL/MariaDB 兼容协议抽取数据,支持全量/增量",
  "fields": [
    { "key": "host", "label": "主机", "type": "text", "required": true, "placeholder": "127.0.0.1" },
    { "key": "port", "label": "端口", "type": "number", "default": 3306 },
    { "key": "database", "label": "数据库", "type": "text", "required": true },
    { "key": "username", "label": "用户名", "type": "text", "required": true },
    { "key": "password", "label": "密码", "type": "password", "required": true },
    { "key": "useSSL", "label": "启用 SSL", "type": "switch", "default": false, "group": "advanced" },
    { "key": "serverTimezone", "label": "时区", "type": "text", "default": "Asia/Shanghai", "group": "advanced" },
    { "key": "defaultFetchSize", "label": "抓取批大小", "type": "number", "default": 1000, "group": "advanced" },
    { "key": "table", "label": "表名", "type": "table-picker", "required": true },
    { "key": "incrementalColumn", "label": "增量字段", "type": "text", "help": "留空则全量抽取" },
    { "key": "schedulingPeriod", "label": "调度周期", "type": "duration", "default": "60 sec", "group": "schedule" }
  ],
  "compile": {
    "controllerServices": [
      {
        "localId": "dbcp",
        "type": "org.apache.nifi.dbcp.DBCPConnectionPool",
        "properties": {
          "Database Connection URL": "jdbc:mysql://${config.host}:${config.port}/${config.database}?useUnicode=true&characterEncoding=UTF-8&serverTimezone=${config.serverTimezone}&useSSL=${config.useSSL}&useCursorFetch=true&defaultFetchSize=${config.defaultFetchSize}&allowPublicKeyRetrieval=true",
          "Database Driver Class Name": "com.mysql.cj.jdbc.Driver",
          "Database Driver Locations": "${jdbc.driverLocations}/mysql-connector-j-8.4.0.jar",
          "Database User": "${config.username}",
          "Password": "${config.password}"
        }
      }
    ],
    "processors": [
      {
        "localId": "fetch",
        "type": "org.apache.nifi.processors.standard.GenerateTableFetch",
        "schedulingPeriod": "${config.schedulingPeriod}",
        "schedulingStrategy": "TIMER_DRIVEN",
        "properties": {
          "Database Connection Pooling Service": "${cs.dbcp}",
          "Table Name": "${config.table}",
          "Maximum-value Columns": "${config.incrementalColumn}",
          "Partition Size": "10000"
        }
      },
      {
        "localId": "execute",
        "type": "org.apache.nifi.processors.standard.ExecuteSQLRecord",
        "properties": {
          "Database Connection Pooling Service": "${cs.dbcp}",
          "Record Writer": "${cs.jsonWriter}"
        }
      }
    ],
    "internalConnections": [
      { "from": "fetch", "to": "execute", "relationship": "success" }
    ],
    "outlets": [
      { "name": "default", "processorRef": "execute", "relationship": "success" }
    ]
  }
}
