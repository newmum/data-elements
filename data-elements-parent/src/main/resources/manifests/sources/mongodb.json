{
  "key": "source.mongodb",
  "category": "source",
  "label": "MongoDB 数据源",
  "icon": "mongodb",
  "description": "按调度全量读取已选集合的文档",
  "fields": [
    {
      "key": "host",
      "label": "主机",
      "type": "text",
      "required": true
    },
    {
      "key": "port",
      "label": "端口",
      "type": "number",
      "default": 27017
    },
    {
      "key": "database",
      "label": "数据库",
      "type": "text",
      "required": true
    },
    {
      "key": "username",
      "label": "用户名",
      "type": "text"
    },
    {
      "key": "password",
      "label": "密码",
      "type": "password"
    },
    {
      "key": "authSource",
      "label": "认证数据库",
      "type": "text",
      "default": "admin"
    },
    {
      "key": "ssl",
      "label": "TLS",
      "type": "switch",
      "default": false
    },
    {
      "key": "table",
      "label": "集合",
      "type": "text",
      "required": true
    },
    {"key": "batchSize", "label": "单批最大条数", "type": "number", "group": "read", "help": "每个输出 FlowFile 的文档数（Results Per FlowFile），取值 1～2147483647。", "default": 1000},
    {"key": "fetchSize", "label": "MongoDB 抓取批大小", "type": "number", "group": "read", "help": "MongoDB 驱动每次从服务器获取的文档数（Batch Size），不限制查询总量；取值 1～2147483647。", "default": 1000},
    {"key": "queryLimit", "label": "单次最大文档数", "type": "number", "group": "read", "help": "单次查询返回的文档总上限（Limit）；留空不设上限。周期查询会重复读取相同范围，不能用本项代替增量水位。"},
    {"key": "queryJson", "label": "查询条件", "type": "json-editor", "group": "read", "help": "MongoDB BSON/JSON 查询文档；默认读取完整集合。", "default": "{}"},
    {"key": "projectionJson", "label": "字段投影", "type": "json-editor", "group": "read", "help": "MongoDB 投影文档，例如 {\"name\":1,\"_id\":0}；排除已登记治理字段前须同步调整映射。"},
    {"key": "sortJson", "label": "排序", "type": "json-editor", "group": "read", "help": "MongoDB 排序文档，例如 {\"_id\":1}；设置查询总上限时建议同时指定稳定排序。"},
    {
      "key": "schedulingPeriod",
      "label": "调度周期",
      "type": "duration",
      "default": "60 sec",
      "group": "schedule"
    }
  ],
  "compile": {
    "controllerServices": [
      {
        "localId": "mongo",
        "type": "org.apache.nifi.mongodb.MongoDBControllerService",
        "properties": {
          "Mongo URI": "${config.mongoUri}",
          "Database User": "${config.username}",
          "Password": "${config.password}"
        }
      }
    ],
    "processors": [
      {
        "localId": "read",
        "type": "org.apache.nifi.processors.mongodb.GetMongo",
        "schedulingPeriod": "${config.schedulingPeriod}",
        "schedulingStrategy": "TIMER_DRIVEN",
        "properties": {
          "Client Service": "${cs.mongo}",
          "Mongo Database Name": "${config.database}",
          "Mongo Collection Name": "${config.table}",
          "Query": "${config.queryJson}",
          "Projection": "${config.projectionJson}",
          "Sort": "${config.sortJson}",
          "Limit": "${config.queryLimit}",
          "JSON Type": "Standard",
          "Date Format": "yyyy-MM-dd'T'HH:mm:ss.SSSXXX",
          "Batch Size": "${config.fetchSize}",
          "Results Per FlowFile": "${config.batchSize}"
        }
      }
    ],
    "outlets": [
      {
        "name": "default",
        "processorRef": "read",
        "relationship": "success"
      }
    ]
  }
}
