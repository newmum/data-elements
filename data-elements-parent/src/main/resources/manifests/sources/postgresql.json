{
  "key": "source.postgresql",
  "category": "source",
  "label": "PostgreSQL 数据源",
  "icon": "postgresql",
  "description": "从 PostgreSQL 抽取数据,支持 schema 与增量字段",
  "fields": [
    { "key": "host", "label": "主机", "type": "text", "required": true },
    { "key": "port", "label": "端口", "type": "number", "default": 5432 },
    { "key": "database", "label": "数据库", "type": "text", "required": true },
    { "key": "currentSchema", "label": "Schema", "type": "text", "default": "public" },
    { "key": "username", "label": "用户名", "type": "text", "required": true },
    { "key": "password", "label": "密码", "type": "password", "required": true },
    { "key": "sslMode", "label": "SSL 模式", "type": "select", "default": "disable", "options": [
      { "label": "关闭", "value": "disable" },
      { "label": "要求", "value": "require" },
      { "label": "校验证书", "value": "verify-ca" },
      { "label": "完全校验", "value": "verify-full" }
    ], "group": "advanced" },
    { "key": "table", "label": "表名", "type": "table-picker", "required": true },
    { "key": "incrementalColumn", "label": "增量字段", "type": "text", "help": "使用数据源登记时选择的时间戳字段，同时用于水位与按月分片；全量模式保留该字段用于分片" },
    { "key": "schedulingPeriod", "label": "调度周期", "type": "duration", "default": "60 sec", "group": "schedule" }
  ],
  "compile": {
    "controllerServices": [
      { "localId": "dbcp", "type": "org.apache.nifi.dbcp.DBCPConnectionPool", "properties": {
        "Database Connection URL": "jdbc:postgresql://${config.host}:${config.port}/${config.database}?currentSchema=${config.currentSchema}&ApplicationName=haitong&prepareThreshold=0&tcpKeepAlive=true&sslmode=${config.sslMode}",
        "Database Driver Class Name": "org.postgresql.Driver",
        "Database Driver Locations": "${jdbc.driverLocations}/postgresql-42.7.4.jar",
        "Database User": "${config.username}",
        "Password": "${config.password}"
      }}
    ],
    "processors": [
      { "localId": "fetch", "type": "com.linewell.microservice.processors.database.GenerateDateTableFetch", "schedulingPeriod": "${config.schedulingPeriod}", "schedulingStrategy": "TIMER_DRIVEN", "properties": { "Database Connection Pooling Service": "${cs.dbcp}", "Table Name": "${config.table}", "Maximum-value Columns": "${config.incrementalColumn}", "gen-table-fetch-partition-size": "10000",
          "gen-table-column-for-val-partitioning": "${config.incrementalColumn}",
          "fetch-partition-type": "2",
          "fetch-partition-type-count": "1",
          "Max Wait Time": "0 seconds" } },
      { "localId": "execute", "type": "org.apache.nifi.processors.standard.ExecuteSQLRecord", "properties": { "Database Connection Pooling Service": "${cs.dbcp}", "Record Writer": "${cs.jsonWriter}" } }
    ],
    "internalConnections": [{ "from": "fetch", "to": "execute", "relationship": "success" }],
    "outlets": [{ "name": "default", "processorRef": "execute", "relationship": "success" }]
  }
}
