{
  "key": "source.gaussdb",
  "category": "source",
  "label": "高斯 GaussDB 数据源",
  "icon": "gaussdb",
  "description": "按实际产品选择华为 GaussDB、openGauss、GaussDB(DWS) 或 MySQL 兼容产品。",
  "fields": [
    {
      "key": "gaussdbVariant",
      "label": "GaussDB 产品",
      "type": "select",
      "required": true,
      "options": [
        {
          "label": "华为 GaussDB（gaussdbjdbc 原生驱动）",
          "value": "gaussdb-jdbc"
        },
        {
          "label": "华为 GaussDB（opengaussjdbc 兼容驱动）",
          "value": "gaussdb"
        },
        {
          "label": "openGauss",
          "value": "opengauss"
        },
        {
          "label": "GaussDB(DWS)",
          "value": "dws"
        },
        {
          "label": "GaussDB(for MySQL)／MySQL 兼容模式",
          "value": "mysql"
        },
        {
          "label": "历史 PostgreSQL 兼容配置",
          "value": "legacy-postgresql"
        }
      ]
    },
    {
      "key": "host",
      "label": "主机",
      "type": "text",
      "required": true
    },
    {
      "key": "port",
      "label": "端口",
      "type": "number",
      "help": "填写实例真实端口：openGauss 常见5432，GaussDB/DWS常见8000，MySQL兼容常见3306。",
      "required": true
    },
    {
      "key": "database",
      "label": "数据库",
      "type": "text",
      "required": true
    },
    {
      "key": "currentSchema",
      "label": "Schema",
      "type": "text",
      "help": "留空使用连接用户的默认 Schema；MySQL 兼容模式使用数据库名。"
    },
    {
      "key": "username",
      "label": "用户名",
      "type": "text",
      "required": true
    },
    {
      "key": "password",
      "label": "密码",
      "type": "password",
      "required": true
    },
    {
      "key": "sslMode",
      "label": "SSL 模式",
      "type": "select",
      "default": "disable",
      "options": [
        {
          "label": "关闭",
          "value": "disable"
        },
        {
          "label": "要求",
          "value": "require"
        },
        {
          "label": "校验证书",
          "value": "verify-ca"
        },
        {
          "label": "完全校验",
          "value": "verify-full"
        }
      ],
      "group": "advanced"
    },
    {
      "key": "table",
      "label": "表名",
      "type": "table-picker",
      "required": true
    },
    {
      "key": "incrementalColumn",
      "label": "增量字段",
      "type": "text",
      "help": "留空则全量抽取"
    },
    {
      "key": "schedulingPeriod",
      "label": "调度周期",
      "type": "duration",
      "default": "60 sec",
      "group": "schedule"
    }
  ],
  "compile": {
    "controllerServices": [
      {
        "localId": "dbcp",
        "type": "org.apache.nifi.dbcp.DBCPConnectionPool",
        "properties": {
          "Database Connection URL": "${jdbc.url}",
          "Database Driver Class Name": "${jdbc.driverClass}",
          "Database Driver Locations": "${jdbc.driverLocations}",
          "Database User": "${config.username}",
          "Password": "${config.password}"
        }
      }
    ],
    "processors": [
      {
        "localId": "fetch",
        "type": "com.linewell.microservice.processors.database.GenerateDateTableFetch",
        "schedulingPeriod": "${config.schedulingPeriod}",
        "schedulingStrategy": "TIMER_DRIVEN",
        "properties": {
          "Database Connection Pooling Service": "${cs.dbcp}",
          "Table Name": "${config.table}",
          "Maximum-value Columns": "${config.incrementalColumn}",
          "gen-table-fetch-partition-size": "10000",
          "gen-table-column-for-val-partitioning": "${config.incrementalColumn}",
          "fetch-partition-type": "2",
          "fetch-partition-type-count": "1",
          "Max Wait Time": "0 seconds"
        }
      },
      {
        "localId": "execute",
        "type": "org.apache.nifi.processors.standard.ExecuteSQLRecord",
        "properties": {
          "Database Connection Pooling Service": "${cs.dbcp}",
          "Record Writer": "${cs.jsonWriter}"
        }
      }
    ],
    "internalConnections": [
      {
        "from": "fetch",
        "to": "execute",
        "relationship": "success"
      }
    ],
    "outlets": [
      {
        "name": "default",
        "processorRef": "execute",
        "relationship": "success"
      }
    ]
  }
}
