{
  "key": "source.sftp",
  "category": "source",
  "label": "SFTP \u6570\u636e\u6e90",
  "icon": "ftp",
  "description": "\u4ece SFTP \u76ee\u5f55\u62c9\u53d6\u6587\u4ef6",
  "fields": [
    { "key": "hostname", "label": "\u4e3b\u673a", "type": "text", "required": true, "placeholder": "192.168.1.10" },
    { "key": "port", "label": "\u7aef\u53e3", "type": "number", "default": 22 },
    { "key": "username", "label": "\u7528\u6237\u540d", "type": "text", "required": true },
    { "key": "password", "label": "\u5bc6\u7801", "type": "password", "required": true },
    { "key": "remotePath", "label": "\u8fdc\u7a0b\u76ee\u5f55", "type": "text", "required": true, "placeholder": "/data/in" },
    { "key": "table", "label": "\u6765\u6e90\u6570\u636e\u96c6", "type": "table-picker", "required": true, "placeholder": "\u9009\u62e9\u6216\u8f93\u5165\u6765\u6e90\u6570\u636e\u96c6" },
    { "key": "fileFilterRegex", "label": "\u6587\u4ef6\u5339\u914d", "type": "text", "default": "(?i).*\\.(csv|json|xlsx|xls)$", "placeholder": "\u4f8b\u5982 (?i).*\\.(csv|json|xlsx|xls)$" },
    { "key": "schedulingPeriod", "label": "\u8c03\u5ea6\u5468\u671f", "type": "duration", "default": "60 sec", "group": "schedule" }
  ],
  "compile": {
    "processors": [
      {
        "localId": "fetch",
        "type": "org.apache.nifi.processors.standard.GetSFTP",
        "schedulingPeriod": "${config.schedulingPeriod}",
        "schedulingStrategy": "TIMER_DRIVEN",
        "properties": {
          "Hostname": "${config.hostname}",
          "Port": "${config.port}",
          "Username": "${config.username}",
          "Password": "${config.password}",
          "Remote Path": "${config.remotePath}",
          "File Filter Regex": "${config.fileFilterRegex}"
        }
      }
    ],
    "outlets": [
      { "name": "default", "processorRef": "fetch", "relationship": "success" }
    ]
  }
}
