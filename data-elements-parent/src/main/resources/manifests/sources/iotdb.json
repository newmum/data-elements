{
  "key": "source.iotdb",
  "category": "source",
  "label": "IoTDB 数据源",
  "icon": "database",
  "description": "从 Huawei MRS IoTDB JDBC 服务抽取时间序列数据",
  "fields": [
    { "key": "host", "label": "主机", "type": "text", "required": true },
    { "key": "port", "label": "端口", "type": "number", "default": 22260 },
    { "key": "username", "label": "用户名", "type": "text", "required": true },
    { "key": "password", "label": "密码", "type": "password", "required": true },
    { "key": "ssl", "label": "启用 SSL", "type": "switch", "default": true, "group": "security" },
    { "key": "trustStorePath", "label": "Truststore 路径", "type": "text", "group": "security" },
    { "key": "krb5ConfPath", "label": "krb5.conf 路径", "type": "text", "group": "security" },
    { "key": "keytabPath", "label": "Keytab 路径", "type": "text", "group": "security" },
    { "key": "userPrincipal", "label": "用户 Principal", "type": "text", "group": "security" },
    { "key": "jdbcUrl", "label": "JDBC URL", "type": "text", "group": "advanced" },
    { "key": "table", "label": "路径/设备", "type": "table-picker", "required": true, "placeholder": "root.sg.device" },
    { "key": "schedulingPeriod", "label": "调度周期", "type": "duration", "default": "60 sec", "group": "schedule" }
  ],
  "compile": {
    "controllerServices": [{ "localId": "dbcp", "type": "org.apache.nifi.dbcp.DBCPConnectionPool", "properties": {
      "Database Connection URL": "${jdbc.url}",
      "Database Driver Class Name": "${jdbc.driverClass}",
      "Database Driver Locations": "${jdbc.driverLocations}",
      "Database User": "${config.username}",
      "Password": "${config.password}"
    }}],
    "processors": [
      { "localId": "query", "type": "org.apache.nifi.processors.standard.ExecuteSQLRecord", "schedulingPeriod": "${config.schedulingPeriod}", "schedulingStrategy": "TIMER_DRIVEN", "properties": { "Database Connection Pooling Service": "${cs.dbcp}", "SQL select query": "SELECT * FROM ${config.table} LIMIT 10000", "Record Writer": "${cs.jsonWriter}" } }
    ],
    "outlets": [{ "name": "default", "processorRef": "query", "relationship": "success" }]
  }
}
