{
  "key": "source.hive",
  "category": "source",
  "label": "Hive 数据源",
  "icon": "database",
  "description": "选择开源 HiveServer2 或服务器托管的华为 MRS Hive；MRS 配置集继续由服务端管理。",
  "fields": [
    {
      "key": "hiveConnectionMode",
      "label": "Hive 类型",
      "type": "select",
      "default": "huawei-mrs",
      "required": true,
      "options": [
        {
          "label": "开源 Hive",
          "value": "open-source"
        },
        {
          "label": "华为 MRS Hive",
          "value": "huawei-mrs"
        }
      ]
    },
    {
      "key": "host",
      "label": "HiveServer2 主机",
      "type": "text",
      "group": "connection"
    },
    {
      "key": "port",
      "label": "端口",
      "type": "number",
      "default": 10000,
      "group": "connection"
    },
    {
      "key": "username",
      "label": "用户名",
      "type": "text",
      "group": "connection"
    },
    {
      "key": "password",
      "label": "密码",
      "type": "password",
      "group": "connection"
    },
    {
      "key": "transportMode",
      "label": "传输方式",
      "type": "select",
      "default": "binary",
      "options": [
        {
          "label": "Binary",
          "value": "binary"
        },
        {
          "label": "HTTP",
          "value": "http"
        }
      ],
      "group": "connection"
    },
    {
      "key": "httpPath",
      "label": "HTTP 路径",
      "type": "text",
      "default": "cliservice",
      "group": "connection"
    },
    {
      "key": "authMode",
      "label": "认证方式",
      "type": "select",
      "default": "none",
      "options": [
        {
          "label": "无认证",
          "value": "none"
        },
        {
          "label": "用户名密码／LDAP",
          "value": "BASIC"
        },
        {
          "label": "NoSASL",
          "value": "NOSASL"
        },
        {
          "label": "Kerberos",
          "value": "KERBEROS"
        }
      ],
      "group": "connection"
    },
    {
      "key": "ssl",
      "label": "TLS",
      "type": "boolean",
      "default": false,
      "group": "connection"
    },
    {
      "key": "principal",
      "label": "服务 Principal",
      "type": "text",
      "group": "advanced"
    },
    {
      "key": "userPrincipal",
      "label": "用户 Principal",
      "type": "text",
      "group": "advanced"
    },
    {
      "key": "keytabPath",
      "label": "Keytab 服务端路径",
      "type": "text",
      "group": "advanced"
    },
    {
      "key": "krb5ConfPath",
      "label": "krb5.conf 服务端路径",
      "type": "text",
      "group": "advanced"
    },
    {
      "key": "driverLocations",
      "label": "NiFi JDBC 驱动路径",
      "type": "text",
      "group": "advanced"
    },
    {
      "key": "hiveProfile",
      "label": "MRS 配置集",
      "type": "select",
      "default": "default",
      "required": false,
      "options": [
        {
          "label": "默认华为 MRS Hive 配置集",
          "value": "default"
        }
      ],
      "group": "connection",
      "help": "由服务器 hive.conf.dir 下的 hiveclient.properties、krb5.conf 与 keytab 自动提供连接参数。"
    },
    {
      "key": "database",
      "label": "Hive 数据库",
      "type": "text",
      "default": "default",
      "required": true,
      "group": "connection"
    },
    {
      "key": "table",
      "label": "表名",
      "type": "table-picker",
      "required": true
    },
    {
      "key": "incrementalColumn",
      "label": "增量字段",
      "type": "text"
    },
    {
      "key": "schedulingPeriod",
      "label": "调度周期",
      "type": "duration",
      "default": "60 sec",
      "group": "schedule"
    }
  ],
  "compile": {
    "controllerServices": [
      {
        "localId": "kerberos",
        "type": "org.apache.nifi.kerberos.KerberosKeytabUserService",
        "properties": {
          "Kerberos Principal": "${config.userPrincipal}",
          "Kerberos Keytab": "${config.keytabPath}"
        }
      },
      {
        "localId": "dbcp",
        "type": "org.apache.nifi.dbcp.DBCPConnectionPool",
        "properties": {
          "Database Connection URL": "${jdbc.url}",
          "Database Driver Class Name": "${jdbc.driverClass}",
          "Database Driver Locations": "${jdbc.driverLocations}",
          "Kerberos User Service": "${cs.kerberos}",
          "Database User": "${config.username}",
          "Password": "${config.password}"
        }
      }
    ],
    "processors": [
      {
        "localId": "fetch",
        "type": "com.linewell.microservice.processors.database.GenerateDateTableFetch",
        "schedulingPeriod": "${config.schedulingPeriod}",
        "schedulingStrategy": "TIMER_DRIVEN",
        "properties": {
          "Database Connection Pooling Service": "${cs.dbcp}",
          "Table Name": "${config.table}",
          "Maximum-value Columns": "${config.incrementalColumn}",
          "gen-table-fetch-partition-size": "10000",
          "gen-table-column-for-val-partitioning": "${config.incrementalColumn}",
          "fetch-partition-type": "2",
          "fetch-partition-type-count": "1",
          "Max Wait Time": "0 seconds"
        }
      },
      {
        "localId": "execute",
        "type": "org.apache.nifi.processors.standard.ExecuteSQLRecord",
        "properties": {
          "Database Connection Pooling Service": "${cs.dbcp}",
          "Record Writer": "${cs.jsonWriter}"
        }
      }
    ],
    "internalConnections": [
      {
        "from": "fetch",
        "to": "execute",
        "relationship": "success"
      }
    ],
    "outlets": [
      {
        "name": "default",
        "processorRef": "execute",
        "relationship": "success"
      }
    ]
  }
}
