{
  "key": "source.oracle",
  "category": "source",
  "label": "Oracle 数据源",
  "icon": "oracle",
  "description": "从 Oracle 抽取数据,支持全量/增量",
  "fields": [
    { "key": "host", "label": "主机", "type": "text", "required": true },
    { "key": "port", "label": "端口", "type": "number", "default": 1521 },
    { "key": "connectionType", "label": "连接方式", "type": "select", "default": "SERVICE_NAME", "options": [
      { "label": "Service Name", "value": "SERVICE_NAME" },
      { "label": "SID", "value": "SID" }
    ] },
    { "key": "sid", "label": "SID/Service", "type": "text", "required": true, "help": "Service Name 模式使用 jdbc:oracle:thin:@//host:port/service；SID 模式由后端/NiFi 适配为 host:port:sid" },
    { "key": "defaultSchema", "label": "默认 Schema/Owner", "type": "text", "group": "advanced" },
    { "key": "username", "label": "用户名", "type": "text", "required": true },
    { "key": "password", "label": "密码", "type": "password", "required": true },
    { "key": "table", "label": "表名", "type": "table-picker", "required": true },
    { "key": "incrementalColumn", "label": "增量字段", "type": "text", "help": "留空则全量抽取" },
    { "key": "schedulingPeriod", "label": "调度周期", "type": "duration", "default": "60 sec", "group": "schedule" }
  ],
  "compile": {
    "controllerServices": [
      {
        "localId": "dbcp",
        "type": "org.apache.nifi.dbcp.DBCPConnectionPool",
        "properties": {
          "Database Connection URL": "${config.jdbcUrl}",
          "Database Driver Class Name": "oracle.jdbc.OracleDriver",
          "Database Driver Locations": "${jdbc.driverLocations}/ojdbc8-12.2.0.1.jar",
          "Database User": "${config.username}",
          "Password": "${config.password}"
        }
      }
    ],
    "processors": [
      {
        "localId": "fetch",
        "type": "org.apache.nifi.processors.standard.GenerateTableFetch",
        "schedulingPeriod": "${config.schedulingPeriod}",
        "schedulingStrategy": "TIMER_DRIVEN",
        "properties": {
          "Database Connection Pooling Service": "${cs.dbcp}",
          "Table Name": "${config.table}",
          "Maximum-value Columns": "${config.incrementalColumn}",
          "Partition Size": "10000"
        }
      },
      {
        "localId": "execute",
        "type": "org.apache.nifi.processors.standard.ExecuteSQLRecord",
        "properties": {
          "Database Connection Pooling Service": "${cs.dbcp}",
          "Record Writer": "${cs.jsonWriter}"
        }
      },
      {
        "localId": "normalize-oracle-sql",
        "type": "org.apache.nifi.processors.standard.ReplaceText",
        "properties": {
          "Replacement Strategy": "Regex Replace",
          "Search Value": "${config.oracleWatermarkSearch}",
          "Replacement Value": "${config.oracleWatermarkReplacement}",
          "Evaluation Mode": "Entire text",
          "Character Set": "UTF-8"
        }
      }
    ],
    "internalConnections": [
      { "from": "fetch", "to": "normalize-oracle-sql", "relationship": "success" },
      { "from": "normalize-oracle-sql", "to": "execute", "relationship": "success" }
    ],
    "outlets": [
      { "name": "default", "processorRef": "execute", "relationship": "success" }
    ]
  }
}
