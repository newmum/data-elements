<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_HOME" value="${DATA_ELEMENTS_LOG_DIR:-../logs/backend}"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender"><encoder class="com.linewell.dataelement.platform.audit.AuditJsonEncoder"/></appender>
    <appender name="MAIN" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/application.jsonl</file>
        <encoder class="com.linewell.dataelement.platform.audit.AuditJsonEncoder"/>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/archive/application-%d{yyyy-MM-dd}.%i.jsonl.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize><maxHistory>14</maxHistory><totalSizeCap>2GB</totalSizeCap><cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>
    <appender name="ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/error.jsonl</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter"><level>ERROR</level></filter>
        <encoder class="com.linewell.dataelement.platform.audit.AuditJsonEncoder"/>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/archive/error-%d{yyyy-MM-dd}.%i.jsonl.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize><maxHistory>14</maxHistory><totalSizeCap>500MB</totalSizeCap><cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>
    <!-- MAIN includes ERROR; its extra ERROR copy is intentional. Combined rolling cap: 2.5GB. -->
    <logger name="org.ssssssss.magicapi.modules.db" level="OFF"/>
    <logger name="org.springframework.jdbc.core" level="WARN"/>
    <logger name="org.mybatis" level="WARN"/>
    <root level="${DATA_ELEMENTS_LOG_LEVEL:-INFO}"><appender-ref ref="CONSOLE"/><appender-ref ref="MAIN"/><appender-ref ref="ERROR"/></root>
</configuration>
