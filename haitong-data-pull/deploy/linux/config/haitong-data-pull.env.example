# 此文件由 systemd 以 EnvironmentFile 方式加载。复制为 haitong-data-pull.env 后填写。
# 不要在 application.yml 中写入密码、密钥或令牌；不要将本文件提交到版本库。
# 示例：sudo install -o root -g haitong -m 0640 config/haitong-data-pull.env.example config/haitong-data-pull.env

# 服务监听
HAITONG_BIND_ADDRESS=0.0.0.0
HAITONG_PORT=18083
HAITONG_WORK_DIR=./data

# Magic-API 编辑器：必须设置强密码；首次启动时自动导入三个“零信任网关对接”脚本。
HAITONG_MAGIC_EDITOR_USERNAME=haitong-admin
HAITONG_MAGIC_EDITOR_PASSWORD=REPLACE_WITH_A_STRONG_EDITOR_PASSWORD
HAITONG_MAGIC_RESOURCE_DIR=./data/magic-api

# MySQL。若设置 HAITONG_DB_URL，则其优先于 host/port/name。
HAITONG_DB_HOST=REPLACE_WITH_MYSQL_HOST
HAITONG_DB_PORT=3306
HAITONG_DB_NAME=haitong
HAITONG_DB_USER=haitong_app
HAITONG_DB_PASSWORD=REPLACE_WITH_MYSQL_PASSWORD
HAITONG_DB_URL=
HAITONG_DB_POOL_SIZE=10

# 对外 /api/v1/data-push 调用方密钥。请求头 X-Api-Key 必须使用此值。
# 生成方式示例：openssl rand -base64 36 | tr -d '\n'
HAITONG_STANDALONE_PUSH_KEY=REPLACE_WITH_A_LONG_RANDOM_PUSH_KEY

# 数据元素平台向本服务同步独立登记镜像（deliveryType=REGISTRY_SYNC）时使用的服务间密钥。
# 如当前不使用同步接口，仍建议设为独立的随机值，勿与 PUSH_KEY 共用。
HAITONG_STANDALONE_REGISTRY_SYNC_KEY=REPLACE_WITH_A_LONG_RANDOM_SYNC_KEY

# FTP 或 SFTP 目标。FTP 与 SFTP 是不同协议：FTP 通常使用 21，SFTP 通常使用 22。
HAITONG_FTP_PROTOCOL=FTP
HAITONG_FTP_HOST=REPLACE_WITH_FTP_HOST
HAITONG_FTP_PORT=21
HAITONG_FTP_USERNAME=REPLACE_WITH_FTP_USERNAME
HAITONG_FTP_PASSWORD=REPLACE_WITH_FTP_PASSWORD
HAITONG_FTP_OUTPUT_DIR=/REPLACE_WITH_FTP_OUTPUT_DIRECTORY
HAITONG_FTP_PASSIVE=true
HAITONG_FTP_IMPLICIT_TLS=false
HAITONG_FTP_ENCODING=UTF-8
HAITONG_FTP_TIMEOUT_SECONDS=30

# 工作线程
HAITONG_REQUESTS_PER_MINUTE=600
HAITONG_WORKER_THREADS_PER_TYPE=2
HAITONG_WORKER_MAX_ATTEMPTS=10
HAITONG_WORKER_POLL_MS=500
HAITONG_WORKER_LEASE_SECONDS=300
HAITONG_WORKER_FILE_BATCH_SIZE=100

# 默认关闭。需要调用零信任网关才将 enabled 改为 true 并补全下列参数。
HAITONG_ZERO_TRUST_ENABLED=false
HAITONG_ZERO_TRUST_TOKEN_URL=
HAITONG_ZERO_TRUST_PUSH_URL=
HAITONG_ZERO_TRUST_CLIENT_ID=
HAITONG_ZERO_TRUST_CLIENT_SECRET=
HAITONG_ZERO_TRUST_REQUESTER_IP=
HAITONG_ZERO_TRUST_TIMEOUT_SECONDS=30
