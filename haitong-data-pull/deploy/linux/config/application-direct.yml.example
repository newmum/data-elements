# ==================== Linux 一键启动直填配置 ====================
# 使用方式：
#   cp config/application-direct.yml.example config/application-direct.yml
#   vi config/application-direct.yml
#   bash start.sh
#
# 本文件不依赖 export、systemd EnvironmentFile 或其他系统环境变量。
# 请仅保存在服务器，权限建议：chmod 600 config/application-direct.yml。
# 所有 REPLACE_WITH_... 都必须替换为真实值，且不要将本文件提交到版本库。

server:
  address: 0.0.0.0
  port: 18083

magic-api:
  web: /api/web
  resource:
    location: ./data/magic-api
  security:
    username: haitong-admin
    password: "REPLACE_WITH_STRONG_MAGIC_EDITOR_PASSWORD"

db:
  type: mysql
  host: "REPLACE_WITH_MYSQL_HOST"
  port: 3306
  name: haitong
  username: "REPLACE_WITH_MYSQL_USERNAME"
  password: "REPLACE_WITH_MYSQL_PASSWORD"
  # 绝大多数情况保留空字符串即可；有专用 JDBC URL 时再填写。
  url: ""
  pool-size: 10
  init-schema: false

relay:
  work-dir: ./data

  # 独立模式不依赖数据元素平台 8088。允许的数据源、表和字段从本地 MySQL 契约表读取。
  registration-registry:
    enabled: false

  standalone-registry:
    sync-enabled: true
    # 数据元素平台调用 REGISTRY_SYNC 同步本地登记镜像时使用；不与推送密钥复用。
    sync-key: "REPLACE_WITH_LONG_RANDOM_REGISTRY_SYNC_KEY"

  standalone:
    datasources: {}

  security:
    requests-per-minute: 600
    clients:
      standalone-publisher:
        # 外部请求 POST /api/v1/data-push 的 X-Api-Key 就是此值。
        api-key: "REPLACE_WITH_LONG_RANDOM_PUSH_KEY"
        channels: [table-to-ftp]
        actions: []

  zero-trust-gateway:
    enabled: false
    token-url: ""
    push-url: ""
    client-id: ""
    client-secret: ""
    requester-ip: ""
    timeout-seconds: 30
    audit-defaults: {}

  ftp:
    enabled: true
    # 普通 FTP 填 FTP，通常使用 21；SFTP 填 SFTP，通常使用 22。两者不能混用。
    protocol: FTP
    host: "REPLACE_WITH_FTP_HOST"
    port: 21
    username: "REPLACE_WITH_FTP_USERNAME"
    password: "REPLACE_WITH_FTP_PASSWORD"
    passive: true
    implicit-tls: false
    encoding: UTF-8
    timeout-seconds: 30
    # 服务端目录；最终位置为 <output-dir>/<datasourceId>/<tableName>/<messageId>.json。
    output-dir: "/REPLACE_WITH_FTP_OUTPUT_DIRECTORY"

  kafka:
    enabled: false

  targets:
    ftp:
      type: FTP
      directory: ""
    table-log:
      type: LOG

  routes:
    table-to-ftp:
      enabled: true
      registration-managed: false
      targets: [ftp]
      file-format: JSONL
      required-fields: [tableName, records]
      batch-key-field: batchId
      business-time-field: occurredAt
    table-to-kafka:
      enabled: false
      registration-managed: false
      targets: []
    table-to-log:
      enabled: false
      targets: [table-log]

  worker:
    enabled: true
    threads-per-type: 2
    max-attempts: 10
    poll-ms: 500
    lease-seconds: 300
    file-batch-size: 100
