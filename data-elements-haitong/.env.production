# Keep the existing NiFi canvas API routes when HaiTong is deployed behind the platform gateway.
VITE_APP_BASE_API=/prod-api/nifi
VITE_APP_DATAASSETS_API=/prod-api

# 源数据管理平台默认部署在同源根路径。子路径部署时由构建环境覆盖。
VITE_SOURCE_PLATFORM_HOME_URL="/#/"

# 同源独立部署有会话键前缀时，与源平台的VITE_APP_STORAGE_PREFIX保持一致；默认不加前缀。
# VITE_SOURCE_PLATFORM_STORAGE_PREFIX=police-mysql
