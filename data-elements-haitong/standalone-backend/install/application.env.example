# Copy to application.env and fill in the values below.
HAITONG_BIND=127.0.0.1
HAITONG_PORT=8090
HAITONG_ADMIN_PASSWORD=
HAITONG_STORE_KEY=
NIFI_URL=https://localhost:8443
NIFI_PARENT_GROUP=root
NIFI_USERNAME=
NIFI_PASSWORD=
# Optional: truststore for the HTTPS connection from Haitong to NiFi.
NIFI_TRUSTSTORE=
NIFI_TRUSTSTORE_PASSWORD=
