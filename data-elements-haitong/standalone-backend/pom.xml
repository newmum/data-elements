<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.linewell.dataelement</groupId>
  <artifactId>haitong-flow-lite</artifactId>
  <version>1.0.0</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <backend.build.directory>${project.basedir}/../../logs/haitong-flow-lite/backend-build</backend.build.directory>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.18.5</version>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId><artifactId>h2</artifactId><version>2.3.232</version>
    </dependency>
  </dependencies>
  <build>
    <directory>${backend.build.directory}</directory>
    <finalName>haitong-flow-lite</finalName>
    <resources>
      <resource><directory>${project.basedir}/../../db/haitong-flow-lite</directory><targetPath>db</targetPath></resource>
      <resource>
        <directory>${project.basedir}/../../data-elements-parent/src/main/resources</directory>
        <includes>
          <include>manifests/sources/mongodb.json</include>
          <include>manifests/sinks/mongodb.json</include>
          <include>manifests/transforms/java.json</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
      <plugin><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId><version>3.6.1</version>
        <executions><execution><id>copy-runtime</id><phase>package</phase><goals><goal>copy-dependencies</goal></goals>
          <configuration><includeScope>runtime</includeScope><outputDirectory>${project.build.directory}/lib</outputDirectory></configuration>
        </execution>
        <execution><id>copy-example-driver</id><phase>package</phase><goals><goal>copy</goal></goals>
          <configuration><artifactItems><artifactItem>
            <groupId>org.mariadb.jdbc</groupId><artifactId>mariadb-java-client</artifactId><version>3.4.1</version>
            <outputDirectory>${project.build.directory}/drivers</outputDirectory>
          </artifactItem></artifactItems></configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
