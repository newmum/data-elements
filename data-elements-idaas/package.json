{
  "name": "data-elements-idaas",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "description": "统一身份管理平台 · React + Ant Design",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run tokens:check && npm run audit:typography && npm test && npm run typecheck && npm run build",
    "syntaxcheck": "node scripts/syntax-check.mjs",
    "test:visual": "playwright test --grep @visual",
    "audit:ui": "node scripts/audit-ui.mjs",
    "test:compact": "playwright test tests/compact.spec.ts",
    "tokens:generate": "node --experimental-strip-types scripts/generate-typography.mjs",
    "tokens:check": "node --experimental-strip-types scripts/generate-typography.mjs --check",
    "audit:typography": "node --experimental-strip-types scripts/audit-typography.mjs",
    "test:typography": "playwright test tests/typography.spec.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "antd": "6.6.5",
    "@ant-design/icons": "6.0.0",
    "dayjs": "1.11.13",
    "react-router-dom": "7.9.1"
  },
  "devDependencies": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/node": "22.18.6",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "@vitejs/plugin-react": "5.0.3",
    "@playwright/test": "1.55.1"
  }
}
